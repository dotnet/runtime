<Project>
  <PropertyGroup>
    <!--
      Set ChromeChannel properties to get the latest versions
    -->
    <ChromeChannel>stable</ChromeChannel>

    <ChromeOSIdentifier Condition="$([MSBuild]::IsOSPlatform('windows'))">Windows</ChromeOSIdentifier>
    <ChromeOSIdentifier Condition="$([MSBuild]::IsOSPlatform('linux'))">Linux</ChromeOSIdentifier>
    <ChromeOSIdentifier Condition="'$(ChromeOSIdentifier)' == ''">unsupported-platform</ChromeOSIdentifier>

    <!-- disable by default on unsupported platforms -->
    <InstallChromeForTests Condition="'$(InstallChromeForTests)' == '' and '$(ChromeOSIdentifier)' == ''">false</InstallChromeForTests>
    <InstallFirefoxForTests Condition="'$(InstallFirefoxForTests)' == '' and '$(ChromeOSIdentifier)' == ''">false</InstallFirefoxForTests>
    <InstallV8ForTests Condition="'$(InstallV8ForTests)' == ''">false</InstallV8ForTests>

    <WasmProvisionAfterTarget Condition="'$(WasmProvisionAfterTarget)' == ''">Build</WasmProvisionAfterTarget>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)BrowserVersions.props" />

  <PropertyGroup>
    <FirefoxDirName>firefox</FirefoxDirName>
    <GeckoDriverDirName>geckodriver</GeckoDriverDirName>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('linux'))">
    <FirefoxRevision>$(linux_FirefoxRevision)</FirefoxRevision>
    <GeckoDriverRevision>$(linux_GeckoDriverRevision)</GeckoDriverRevision>
    <FirefoxUrl>https://ftp.mozilla.org/pub/firefox/releases/$(linux_FirefoxRevision)/linux-x86_64/en-US/firefox-$(linux_FirefoxRevision).tar.xz</FirefoxUrl>
    <GeckoDriverUrl>https://github.com/mozilla/geckodriver/releases/download/v$(linux_GeckoDriverRevision)/geckodriver-v$(linux_GeckoDriverRevision)-linux64.tar.gz</GeckoDriverUrl>
    <FirefoxBinaryName>firefox</FirefoxBinaryName>
    <GeckoDriverBinaryName>geckodriver</GeckoDriverBinaryName>
    <_FirefoxArchiveKind>tarxz</_FirefoxArchiveKind>
    <_GeckoDriverArchiveKind>targz</_GeckoDriverArchiveKind>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <FirefoxRevision>$(win_FirefoxRevision)</FirefoxRevision>
    <GeckoDriverRevision>$(win_GeckoDriverRevision)</GeckoDriverRevision>
    <FirefoxUrl>https://ftp.mozilla.org/pub/firefox/releases/$(win_FirefoxRevision)/win64/en-US/Firefox%20Setup%20$(win_FirefoxRevision).exe</FirefoxUrl>
    <GeckoDriverUrl>https://github.com/mozilla/geckodriver/releases/download/v$(win_GeckoDriverRevision)/geckodriver-v$(win_GeckoDriverRevision)-win64.zip</GeckoDriverUrl>
    <FirefoxBinaryName>firefox.exe</FirefoxBinaryName>
    <GeckoDriverBinaryName>geckodriver.exe</GeckoDriverBinaryName>
    <_FirefoxArchiveKind>firefox-installer</_FirefoxArchiveKind>
    <_GeckoDriverArchiveKind>zip</_GeckoDriverArchiveKind>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FirefoxRevision)' != ''">
    <!-- The tools are laid out as <cache>/<tool>/<version>-<rid>/<DirName>/<binary>, because the
         Helix payload layout and the test runners address them by $(FirefoxDirName) etc. The
         Linux Firefox tarball already contains a top level 'firefox' directory; on Windows the
         installer is pointed at one. -->
    <FirefoxDir>$([MSBuild]::NormalizeDirectory('$(WasmToolCacheDir)', 'firefox', '$(FirefoxRevision)-$(WasmToolHostRid)'))</FirefoxDir>
    <FirefoxStampFile>$([MSBuild]::NormalizePath('$(WasmToolCacheDir)', 'firefox', '$(FirefoxRevision)-$(WasmToolHostRid).complete'))</FirefoxStampFile>
    <FirefoxBinaryPath>$([MSBuild]::NormalizePath($(FirefoxDir), $(FirefoxDirName), $(FirefoxBinaryName)))</FirefoxBinaryPath>
    <_FirefoxSubDir Condition="'$(_FirefoxArchiveKind)' == 'firefox-installer'">$(FirefoxDirName)</_FirefoxSubDir>

    <GeckoDriverDir>$([MSBuild]::NormalizeDirectory('$(WasmToolCacheDir)', 'geckodriver', '$(GeckoDriverRevision)-$(WasmToolHostRid)'))</GeckoDriverDir>
    <GeckoDriverStampFile>$([MSBuild]::NormalizePath('$(WasmToolCacheDir)', 'geckodriver', '$(GeckoDriverRevision)-$(WasmToolHostRid).complete'))</GeckoDriverStampFile>
    <GeckoDriverBinaryPath>$([MSBuild]::NormalizePath($(GeckoDriverDir), $(GeckoDriverDirName), $(GeckoDriverBinaryName)))</GeckoDriverBinaryPath>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('linux'))">
    <ChromeDirName>chrome-linux</ChromeDirName>
    <ChromeDriverDirName>chromedriver_linux64</ChromeDriverDirName>
    <ChromeBinaryName>chrome</ChromeBinaryName>
    <ChromeDriverBinaryName>chromedriver</ChromeDriverBinaryName>
    <_ChromeOSPrefix>Linux_x64</_ChromeOSPrefix>

    <ChromeVersion>$(linux_ChromeVersion)</ChromeVersion>
    <ChromeRevision>$(linux_ChromeRevision)</ChromeRevision>
    <_ChromeBaseSnapshotUrl>$(linux_ChromeBaseSnapshotUrl)</_ChromeBaseSnapshotUrl>

    <ChromeUrl>$(linux_ChromeBaseSnapshotUrl)/chrome-linux.zip</ChromeUrl>
    <ChromeDriverUrl>$(linux_ChromeBaseSnapshotUrl)/chromedriver_linux64.zip</ChromeDriverUrl>

    <V8Version>$(linux_V8Version)</V8Version>
    <V8DirName>v8-$(linux_V8Version)</V8DirName>
    <V8BinaryName>$(V8DirName).sh</V8BinaryName>
    <_V8PlatformId>linux64</_V8PlatformId>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('macos'))">
    <ChromeDirName>chrome-mac/Chromium.app/Contents/MacOS</ChromeDirName>
    <ChromeDriverDirName>chromedriver_mac64</ChromeDriverDirName>
    <ChromeBinaryName>Chromium</ChromeBinaryName>
    <ChromeDriverBinaryName>chromedriver</ChromeDriverBinaryName>
    <_ChromeOSPrefix>Mac_Arm</_ChromeOSPrefix>

    <ChromeVersion>$(macos_ChromeVersion)</ChromeVersion>
    <ChromeRevision>$(macos_ChromeRevision)</ChromeRevision>
    <_ChromeBaseSnapshotUrl>$(macos_ChromeBaseSnapshotUrl)</_ChromeBaseSnapshotUrl>

    <ChromeUrl>$(macos_ChromeBaseSnapshotUrl)/chrome-mac.zip</ChromeUrl>
    <ChromeDriverUrl>$(macos_ChromeBaseSnapshotUrl)/chromedriver_mac64.zip</ChromeDriverUrl>

    <V8Version>$(macos_V8Version)</V8Version>
    <V8DirName>v8-$(macos_V8Version)</V8DirName>
    <V8BinaryName>$(V8DirName).sh</V8BinaryName>
    <_V8PlatformId>mac-arm64</_V8PlatformId>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <ChromeDirName>chrome-win</ChromeDirName>
    <ChromeDriverDirName>chromedriver_win32</ChromeDriverDirName>
    <ChromeBinaryName>chrome.exe</ChromeBinaryName>
    <ChromeDriverBinaryName>chromedriver.exe</ChromeDriverBinaryName>
    <_ChromeOSPrefix>Win_x64</_ChromeOSPrefix>

    <ChromeVersion>$(win_ChromeVersion)</ChromeVersion>
    <ChromeRevision>$(win_ChromeRevision)</ChromeRevision>
    <_ChromeBaseSnapshotUrl>$(win_ChromeBaseSnapshotUrl)</_ChromeBaseSnapshotUrl>

    <ChromeUrl>$(win_ChromeBaseSnapshotUrl)/chrome-win.zip</ChromeUrl>
    <ChromeDriverUrl>$(win_ChromeBaseSnapshotUrl)/chromedriver_win32.zip</ChromeDriverUrl>

    <V8Version>$(win_V8Version)</V8Version>
    <V8DirName>v8-$(win_V8Version)</V8DirName>
    <V8BinaryName>$(V8DirName).cmd</V8BinaryName>
    <_V8PlatformId>win32</_V8PlatformId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ChromeVersion)' != ''">
    <ChromeDir>$([MSBuild]::NormalizeDirectory('$(WasmToolCacheDir)', 'chrome', '$(ChromeVersion)-$(ChromeRevision)-$(WasmToolHostRid)'))</ChromeDir>
    <ChromeStampFile>$([MSBuild]::NormalizePath('$(WasmToolCacheDir)', 'chrome', '$(ChromeVersion)-$(ChromeRevision)-$(WasmToolHostRid).complete'))</ChromeStampFile>
    <ChromeDriverDir>$([MSBuild]::NormalizeDirectory('$(WasmToolCacheDir)', 'chromedriver', '$(ChromeVersion)-$(ChromeRevision)-$(WasmToolHostRid)'))</ChromeDriverDir>
    <ChromeDriverStampFile>$([MSBuild]::NormalizePath('$(WasmToolCacheDir)', 'chromedriver', '$(ChromeVersion)-$(ChromeRevision)-$(WasmToolHostRid).complete'))</ChromeDriverStampFile>

    <ChromeBinaryPath>$([MSBuild]::NormalizePath($(ChromeDir), $(ChromeDirName), $(ChromeBinaryName)))</ChromeBinaryPath>
    <ChromeDriverBinaryPath>$([MSBuild]::NormalizePath($(ChromeDriverDir), $(ChromeDriverDirName), $(ChromeDriverBinaryName)))</ChromeDriverBinaryPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(V8Version)' != ''">
    <V8Dir>$([MSBuild]::NormalizeDirectory('$(WasmToolCacheDir)', 'v8', '$(V8Version)-$(WasmToolHostRid)'))</V8Dir>
    <V8StampFile>$([MSBuild]::NormalizePath('$(WasmToolCacheDir)', 'v8', '$(V8Version)-$(WasmToolHostRid).complete'))</V8StampFile>
    <V8BinaryPath>$([MSBuild]::NormalizePath($(V8Dir), $(V8BinaryName)))</V8BinaryPath>
    <_V8SnapshotUrl>https://storage.googleapis.com/chromium-v8/official/canary/v8-$(_V8PlatformId)-rel-$(V8Version).zip</_V8SnapshotUrl>
  </PropertyGroup>

  <PropertyGroup>
    <_V8Script Condition="$([MSBuild]::IsOSPlatform('linux')) or $([MSBuild]::IsOSPlatform('macos'))">#!/usr/bin/env bash
export __SCRIPT_DIR=%24( cd -- "%24( dirname -- "%24{BASH_SOURCE[0]}" )" &amp;> /dev/null &amp;&amp; pwd )
"$__SCRIPT_DIR/d8" --snapshot_blob="$__SCRIPT_DIR/snapshot_blob.bin" "$@"
    </_V8Script>
    <_V8Script Condition="$([MSBuild]::IsOSPlatform('windows'))">@echo off
"%~dp0d8.exe" --snapshot_blob="%~dp0snapshot_blob.bin" %*
    </_V8Script>
  </PropertyGroup>

  <Target Name="ProvisionBrowsersForTests"
          AfterTargets="$(WasmProvisionAfterTarget)"
          Condition="'$(InstallChromeForTests)' == 'true' or '$(InstallFirefoxForTests)' == 'true' or '$(InstallV8ForTests)' == 'true'">

    <!-- On Linux the Chrome/chromedriver/Firefox/geckodriver/V8 download URLs are x86_64-only, but
         the cache entry is keyed by $(WasmToolHostRid). Fail fast rather than caching an x64 payload
         under a linux-arm64 key. (macOS selects arm64/x64 URLs; Windows is x64.) -->
    <Error Condition="$([MSBuild]::IsOSPlatform('linux')) and '$(BuildArchitecture)' != 'x64'"
           Text="Browser and JS engine test tools are only available for x64 on Linux; provisioning them for '$(BuildArchitecture)' is not supported. Set InstallChromeForTests/InstallFirefoxForTests/InstallV8ForTests=false, or point the *_PATH_FOR_TESTS variables at a local install." />

    <Error Condition="'$(InstallChromeForTests)' == 'true' and '$(ChromeVersion)' == ''"
           Text="No %24(ChromeVersion) set. This can be set in eng/testing/BrowserVersions.props" />
    <Error Condition="'$(InstallV8ForTests)' == 'true' and '$(V8Version)' == ''"
           Text="%24(V8Version) not set. This can be set in eng/testing/BrowserVersions.props" />
    <Error Condition="'$(InstallV8ForTests)' == 'true' and '$(_V8PlatformId)' == ''"
           Text="%24(_V8PlatformId) not set, needed for constructing the snapshot url." />
    <Error Condition="'$(InstallFirefoxForTests)' == 'true' and '$(FirefoxRevision)' == ''"
           Text="Firefox provisioning is only supported on Linux and Windows." />

    <ItemGroup Condition="'$(InstallChromeForTests)' == 'true'">
      <_WasmToolToAcquire Include="chrome $(ChromeVersion) (rev $(ChromeRevision))"
                          Url="$(ChromeUrl)"
                          Kind="zip"
                          CacheDir="$(ChromeDir)"
                          StampFile="$(ChromeStampFile)"
                          Verify="$(ChromeBinaryPath)"
                          Chmod="$(ChromeBinaryPath)" />
      <_WasmToolToAcquire Include="chromedriver $(ChromeVersion) (rev $(ChromeRevision))"
                          Url="$(ChromeDriverUrl)"
                          Kind="zip"
                          CacheDir="$(ChromeDriverDir)"
                          StampFile="$(ChromeDriverStampFile)"
                          Verify="$(ChromeDriverBinaryPath)"
                          Chmod="$(ChromeDriverBinaryPath)" />
    </ItemGroup>

    <ItemGroup Condition="'$(InstallFirefoxForTests)' == 'true'">
      <_WasmToolToAcquire Include="firefox $(FirefoxRevision)"
                          Url="$(FirefoxUrl)"
                          Kind="$(_FirefoxArchiveKind)"
                          SubDir="$(_FirefoxSubDir)"
                          CacheDir="$(FirefoxDir)"
                          StampFile="$(FirefoxStampFile)"
                          Verify="$(FirefoxBinaryPath)"
                          Chmod="$(FirefoxBinaryPath)" />
      <_WasmToolToAcquire Include="geckodriver $(GeckoDriverRevision)"
                          Url="$(GeckoDriverUrl)"
                          Kind="$(_GeckoDriverArchiveKind)"
                          SubDir="$(GeckoDriverDirName)"
                          CacheDir="$(GeckoDriverDir)"
                          StampFile="$(GeckoDriverStampFile)"
                          Verify="$(GeckoDriverBinaryPath)"
                          Chmod="$(GeckoDriverBinaryPath)" />
    </ItemGroup>

    <!-- V8 ships without a launcher, so stage one and let the acquisition publish it as part of
         the cache entry rather than writing into an already-stamped directory. The download
         directory may not exist yet on a fresh checkout, so create it before writing. -->
    <MakeDir Condition="'$(InstallV8ForTests)' == 'true' and !Exists('$(V8StampFile)')"
             Directories="$(WasmToolDownloadDir)" />
    <WriteLinesToFile Condition="'$(InstallV8ForTests)' == 'true' and !Exists('$(V8StampFile)')"
                      File="$(WasmToolDownloadDir)$(V8BinaryName)"
                      Lines="$(_V8Script)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup Condition="'$(InstallV8ForTests)' == 'true'">
      <_WasmToolToAcquire Include="v8 $(V8Version)"
                          Url="$(_V8SnapshotUrl)"
                          Kind="zip"
                          CacheDir="$(V8Dir)"
                          StampFile="$(V8StampFile)"
                          LauncherSource="$(WasmToolDownloadDir)$(V8BinaryName)"
                          LauncherName="$(V8BinaryName)"
                          Verify="$(V8BinaryPath)"
                          Chmod="$(V8BinaryPath);$(V8Dir)d8" />
    </ItemGroup>

    <MSBuild Projects="$(RepositoryEngineeringDir)wasm\AcquireWasmTool.proj"
             Targets="AcquireWasmTool"
             Condition="!Exists('%(_WasmToolToAcquire.StampFile)')"
             Properties="WasmToolName=%(_WasmToolToAcquire.Identity);
                         WasmToolUrl=%(_WasmToolToAcquire.Url);
                         WasmToolKind=%(_WasmToolToAcquire.Kind);
                         WasmToolSubDir=%(_WasmToolToAcquire.SubDir);
                         WasmToolCacheEntryDir=%(_WasmToolToAcquire.CacheDir);
                         WasmToolStampFile=%(_WasmToolToAcquire.StampFile);
                         WasmToolVerify=%(_WasmToolToAcquire.Verify);
                         WasmToolChmod=%(_WasmToolToAcquire.Chmod);
                         WasmToolLauncherSource=%(_WasmToolToAcquire.LauncherSource);
                         WasmToolLauncherName=%(_WasmToolToAcquire.LauncherName);
                         WasmToolDownloadDir=$(WasmToolDownloadDir);
                         HostOS=$(HostOS)" />
  </Target>
</Project>
