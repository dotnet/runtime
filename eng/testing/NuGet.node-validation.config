  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="darc-pub-dotnet-dotnet-65ad2fc7" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/darc-pub-dotnet-dotnet-65ad2fc7/nuget/v3/index.json" />
