<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Validation only. Template for the workload install in eng/testing/workloads-browser.targets. It adds the
       isolated feed of the dotnet/dotnet validation build and maps the Emscripten packages to that feed alone,
       because the same versions were released with an older Node. -->
  <fallbackPackageFolders>
