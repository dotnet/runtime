<Project>
  <!-- Settings for tools that publish as AOT -->

  <PropertyGroup Condition="'$(AotOrSingleFile)' == 'true' and '$(UseNativeAotForComponents)' == 'true'">
    <PublishAot>true</PublishAot>
    <!-- Use .dwarf files instead of .dsym files since our symbol exporting may not safely handle folders. -->
    <NativeSymbolExt Condition="'$(_IsApplePlatform)' == 'true'">.dwarf</NativeSymbolExt>
    <DsymUtilOptions Condition="'$(_IsApplePlatform)' == 'true'">--flat</DsymUtilOptions>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AotOrSingleFile)' == 'true' and '$(UseNativeAotForComponents)' != 'true'">
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <_TrueTargetRid>$(RuntimeIdentifier)</_TrueTargetRid>
    <!--
      NativeAOT's targets don't handle cross-targeting to a non-portable RID.
      Change the RID when importing the NativeAOT targets to the corresponding portable RID.
    -->
    <RuntimeIdentifier>$(PortableTargetRid)</RuntimeIdentifier>
  </PropertyGroup>
  <Import Project="$(CoreCLRBuildIntegrationDir)Microsoft.DotNet.ILCompiler.SingleEntry.targets" Condition="'$(PublishAot)' == 'true' and '$(UseBootstrapLayout)' == 'true'" />
  <PropertyGroup>
    <RuntimeIdentifier>$(_TrueTargetRid)</RuntimeIdentifier>
  </PropertyGroup>


  <Target Name="LocateNativeCompiler"
          Condition="'$(UseNativeAotForComponents)' == 'true' and '$(HostOS)' != 'windows'"
          BeforeTargets="SetupOSSpecificProps">
      <PropertyGroup>
        <CppCompilerAndLinker Condition="'$(CppCompilerAndLinker)' == ''">clang</CppCompilerAndLinker>
        <SysRoot Condition="'$(CrossBuild)' == 'true'">$(ROOTFS_DIR)</SysRoot>
      </PropertyGroup>

      <Exec Command="sh -c 'build_arch=&quot;$(TargetArchitecture)&quot; compiler=&quot;$(CppCompilerAndLinker)&quot; . &quot;$(RepositoryEngineeringDir)/common/native/init-compiler.sh&quot; &amp;&amp; echo &quot;$CC;$LDFLAGS&quot;' 2>/dev/null"
            EchoOff="true"
            ConsoleToMsBuild="true"
            StandardOutputImportance="Low">
        <Output TaskParameter="ConsoleOutput" PropertyName="_CC_LDFLAGS" />
      </Exec>

    <PropertyGroup>
      <CppLinker>$(_CC_LDFLAGS.SubString(0, $(_CC_LDFLAGS.IndexOf(';'))))</CppLinker>
      <_LDFLAGS>$(_CC_LDFLAGS.SubString($([MSBuild]::Add($(_CC_LDFLAGS.IndexOf(';')), 1))))</_LDFLAGS>
      <LinkerFlavor Condition="$(_LDFLAGS.Contains('lld'))">lld</LinkerFlavor>
    </PropertyGroup>
  </Target>

  <ItemGroup Condition="'$(PublishAot)' == 'true' and '$(PortableOS)' == 'osx' and '$(OutputType)' == 'Exe' and '$(NativeLib)' == '' and '$(HostBundleIdentifier)' != ''">
    <PackageReference Include="Microsoft.DotNet.Build.Tasks.Templating" Version="$(MicrosoftDotNetBuildTasksTemplatingVersion)" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="GenerateHostInfoPlist"
          BeforeTargets="LinkNative"
          Condition="'$(PublishAot)' == 'true' and '$(PortableOS)' == 'osx' and '$(OutputType)' == 'Exe' and '$(NativeLib)' == '' and '$(HostBundleIdentifier)' != ''">
    <Error Condition="'$(HostBundleName)' == ''" Text="HostBundleName must be set when HostBundleIdentifier is set." />

    <PropertyGroup>
      <_HostInfoPlist>$(NativeIntermediateOutputPath)$(TargetName).Info.plist</_HostInfoPlist>
      <_HostBundleIdentifierXml>$(HostBundleIdentifier.Replace('&amp;', '&amp;amp;').Replace('&lt;', '&amp;lt;').Replace('&gt;', '&amp;gt;').Replace("'", '&amp;apos;'))</_HostBundleIdentifierXml>
      <_HostBundleNameXml>$(HostBundleName.Replace('&amp;', '&amp;amp;').Replace('&lt;', '&amp;lt;').Replace('&gt;', '&amp;gt;').Replace("'", '&amp;apos;'))</_HostBundleNameXml>
    </PropertyGroup>

    <!-- Stage the rendered template so unchanged metadata does not force a native relink. -->
    <GenerateFileFromTemplate TemplateFile="$(MSBuildThisFileDirectory)native/Info.plist.in"
                              OutputPath="$(_HostInfoPlist).tmp"
                              Properties="MACOS_BUNDLE_IDENTIFIER=$([MSBuild]::Escape('$(_HostBundleIdentifierXml)'));targetName=$([MSBuild]::Escape('$(_HostBundleNameXml)'))" />
    <PropertyGroup>
      <_HostInfoPlistContents>$([System.IO.File]::ReadAllText('$(_HostInfoPlist).tmp').TrimEnd())</_HostInfoPlistContents>
    </PropertyGroup>
    <WriteLinesToFile File="$(_HostInfoPlist)"
                      Lines="$([MSBuild]::Escape('$(_HostInfoPlistContents)'))"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <LinkerArg Include="-Wl,-sectcreate,__TEXT,__info_plist -Xlinker &quot;$(_HostInfoPlist)&quot;" />
      <!-- Native libraries have already been expanded into linker arguments by SetupOSSpecificProps.
           Track the plist as a linking input without passing it as a library. -->
      <NativeLibrary Include="$(_HostInfoPlist)" />
      <FileWrites Include="$(_HostInfoPlist);$(_HostInfoPlist).tmp" />
    </ItemGroup>
  </Target>

  <Target Name="AdHocSignHost"
          AfterTargets="LinkNative"
          Condition="'$(PublishAot)' == 'true' and '$(PortableOS)' == 'osx' and '$(OutputType)' == 'Exe' and '$(NativeLib)' == '' and '$(HostBundleIdentifier)' != ''">
    <!-- Sign after LinkNative finishes modifying the binary, including symbol stripping, and before publish copies it. -->
    <Exec Command="codesign --sign - --force --preserve-metadata=entitlements,requirements,flags,runtime,launch-constraints,library-constraints --identifier &quot;$(HostBundleIdentifier)&quot; &quot;$(NativeBinary)&quot;" />
  </Target>

</Project>
