<!--
  Acquires the host tools used to compose a CoreCLR-WASI composite ReadyToRun image into the app
  host (wasm-tools, and Binaryen's wasm-merge and wasm-opt) into the shared cache described in
  eng/wasm/WasmToolCache.props.
-->
<Project>
  <PropertyGroup>
    <_WasiR2RToolOS Condition="'$(HostOS)' == 'linux'">linux</_WasiR2RToolOS>
    <_WasiR2RToolOS Condition="'$(HostOS)' == 'osx'">macos</_WasiR2RToolOS>
    <_WasiR2RToolArch Condition="'$(BuildArchitecture)' == 'x64'">x86_64</_WasiR2RToolArch>
    <_WasiR2RToolArch Condition="'$(BuildArchitecture)' == 'arm64'">aarch64</_WasiR2RToolArch>
    <_BinaryenArch>$(_WasiR2RToolArch)</_BinaryenArch>
    <_BinaryenArch Condition="'$(HostOS)' == 'osx' and '$(BuildArchitecture)' == 'arm64'">arm64</_BinaryenArch>
    <_BinaryenArchiveName>binaryen-version_$(BinaryenVersion)-$(_BinaryenArch)-$(_WasiR2RToolOS)</_BinaryenArchiveName>
    <_WasmToolsArchiveName>wasm-tools-$(WasmToolsVersion)-$(_WasiR2RToolArch)-$(_WasiR2RToolOS)</_WasmToolsArchiveName>

    <_BinaryenSha256 Condition="'$(WasmToolHostRid)' == 'linux-x64'">0a18362361ad05465118cd8eeb72edaeec89de6894bc283576ef4e07aa3babcc</_BinaryenSha256>
    <_BinaryenSha256 Condition="'$(WasmToolHostRid)' == 'linux-arm64'">e6ae6e09ac40f4e14bc5be6f687c58e2995c84170013975fa641809dd3b480a0</_BinaryenSha256>
    <_BinaryenSha256 Condition="'$(WasmToolHostRid)' == 'osx-x64'">d3e2d1235b70c93c54b52eabc1625ea960965152218754f1f4eeb0f873c48e03</_BinaryenSha256>
    <_BinaryenSha256 Condition="'$(WasmToolHostRid)' == 'osx-arm64'">79d3ab9f417d9e215f15f598f523d001a7d9ac1e59367e5c869fbdabd1cba72e</_BinaryenSha256>

    <_WasmToolsSha256 Condition="'$(WasmToolHostRid)' == 'linux-x64'">4e2898f7ca3bd0536218ed9b7b36ff7b86954c57ae0e6272fde69728cbe01088</_WasmToolsSha256>
    <_WasmToolsSha256 Condition="'$(WasmToolHostRid)' == 'linux-arm64'">4a9a1c6a0885aaf17f433f2927bd61b1fe40069836f750f4e9f9ccd661106c65</_WasmToolsSha256>
    <_WasmToolsSha256 Condition="'$(WasmToolHostRid)' == 'osx-x64'">9e311880fe8fcb7ef55cfeea98dc6235440a0aa0a66373affdda4bc1dde47602</_WasmToolsSha256>
    <_WasmToolsSha256 Condition="'$(WasmToolHostRid)' == 'osx-arm64'">27b5f83d82ae8f2d961b5a87bdc024bca9db851a7b617d14065cec196fed29d7</_WasmToolsSha256>
  </PropertyGroup>

  <!-- Composition runs on the build host, not on the wasm target. Use the same
       version/host-keyed cache and atomic acquisition as wasi-sdk and wasmtime. -->
  <Target Name="AcquireWasiR2RTools">
    <Error Condition="'$(_WasiR2RToolOS)' == '' or '$(_WasiR2RToolArch)' == ''"
           Text="WASI R2R tool acquisition requires a Linux or macOS x64/arm64 host, not $(WasmToolHostRid)." />
    <Error Condition="'$(_BinaryenSha256)' == '' or '$(_WasmToolsSha256)' == ''"
           Text="WASI R2R tool acquisition has no SHA-256 hashes for host $(WasmToolHostRid)." />

    <MSBuild Projects="$(RepositoryEngineeringDir)wasm\AcquireWasmTool.proj"
             Targets="AcquireWasmTool"
             Properties="WasmToolName=Binaryen $(BinaryenVersion);
                         WasmToolUrl=https://github.com/WebAssembly/binaryen/releases/download/version_$(BinaryenVersion)/$(_BinaryenArchiveName).tar.gz;
                         WasmToolSha256=$(_BinaryenSha256);
                         WasmToolKind=targz;
                         WasmToolInnerDir=binaryen-version_$(BinaryenVersion);
                         WasmToolCacheEntryDir=$(BinaryenCacheDir);
                         WasmToolStampFile=$(BinaryenStampFile);
                         WasmToolVerify=$(BinaryenCacheDir)bin/wasm-merge;
                         WasmToolChmod=$(BinaryenCacheDir)bin/wasm-merge;
                         WasmToolDownloadDir=$(WasmToolDownloadDir);
                         HostOS=$(HostOS)" />
    <Error Condition="!Exists('$(BinaryenCacheDir)bin/wasm-opt')"
           Text="The Binaryen $(BinaryenVersion) cache entry is missing wasm-opt: $(BinaryenCacheDir)" />

    <MSBuild Projects="$(RepositoryEngineeringDir)wasm\AcquireWasmTool.proj"
             Targets="AcquireWasmTool"
             Properties="WasmToolName=wasm-tools $(WasmToolsVersion);
                         WasmToolUrl=https://github.com/bytecodealliance/wasm-tools/releases/download/v$(WasmToolsVersion)/$(_WasmToolsArchiveName).tar.gz;
                         WasmToolSha256=$(_WasmToolsSha256);
                         WasmToolKind=targz;
                         WasmToolInnerDir=$(_WasmToolsArchiveName);
                         WasmToolCacheEntryDir=$(WasmToolsCacheDir);
                         WasmToolStampFile=$(WasmToolsStampFile);
                         WasmToolVerify=$(WasmToolsCacheDir)wasm-tools;
                         WasmToolChmod=$(WasmToolsCacheDir)wasm-tools;
                         WasmToolDownloadDir=$(WasmToolDownloadDir);
                         HostOS=$(HostOS)" />
  </Target>
</Project>
