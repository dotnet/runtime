<Project>
  <!--
    RIDs listed in the runtime.json of lineup packages.

    IsOfficial: RID-specific packages are built and published by official builds, so they can be
    restored. Community RIDs are listed so that others can provide the packages.
  -->
  <ItemGroup>
    <PackageRID Include="win-x64" Platform="x64" IsOfficial="true" />
    <PackageRID Include="win-arm64" Platform="arm64" IsOfficial="true" />
    <PackageRID Include="win-x86" Platform="x86" IsOfficial="true" />

    <PackageRID Include="osx-x64" Platform="x64" IsOfficial="true" />
    <PackageRID Include="osx-arm64" Platform="arm64" IsOfficial="true" />

    <PackageRID Include="linux-x64" Platform="x64" IsOfficial="true" />
    <PackageRID Include="linux-arm64" Platform="arm64" IsOfficial="true" />
    <PackageRID Include="linux-arm" Platform="arm" IsOfficial="true" />
    <PackageRID Include="linux-x86" Platform="x86" IsOfficial="false" />
    <PackageRID Include="linux-armv6" Platform="armv6" IsOfficial="false" />
    <PackageRID Include="linux-riscv64" Platform="riscv64" IsOfficial="false" />
    <PackageRID Include="linux-loongarch64" Platform="loongarch64" IsOfficial="false" />
    <PackageRID Include="linux-ppc64le" Platform="ppc64le" IsOfficial="false" />
    <PackageRID Include="linux-s390x" Platform="s390x" IsOfficial="false" />

    <PackageRID Include="linux-musl-x64" Platform="x64" IsOfficial="true" />
    <PackageRID Include="linux-musl-arm64" Platform="arm64" IsOfficial="true" />
    <PackageRID Include="linux-musl-arm" Platform="arm" IsOfficial="true" />
    <PackageRID Include="linux-musl-x86" Platform="x86" IsOfficial="false" />
    <PackageRID Include="linux-musl-riscv64" Platform="riscv64" IsOfficial="false" />
    <PackageRID Include="linux-musl-loongarch64" Platform="loongarch64" IsOfficial="false" />
    <PackageRID Include="linux-musl-ppc64le" Platform="ppc64le" IsOfficial="false" />
    <PackageRID Include="linux-musl-s390x" Platform="s390x" IsOfficial="false" />

    <PackageRID Include="linux-bionic-x64" Platform="x64" IsOfficial="true" />
    <PackageRID Include="linux-bionic-arm64" Platform="arm64" IsOfficial="true" />
    <PackageRID Include="linux-bionic-arm" Platform="arm" IsOfficial="true" />
    <PackageRID Include="linux-bionic-x86" Platform="x86" IsOfficial="false" />

    <PackageRID Include="tizen.4.0.0-armel" Platform="armel" IsOfficial="false" />
    <PackageRID Include="tizen.5.0.0-armel" Platform="armel" IsOfficial="false" />

    <PackageRID Include="openharmony-x64" Platform="x64" IsOfficial="false" />
    <PackageRID Include="openharmony-arm64" Platform="arm64" IsOfficial="false" />
    <PackageRID Include="openharmony-arm" Platform="arm" IsOfficial="false" />

    <PackageRID Include="freebsd-x64" Platform="x64" IsOfficial="false" />
    <PackageRID Include="freebsd-arm64" Platform="arm64" IsOfficial="false" />
    <PackageRID Include="netbsd-x64" Platform="x64" IsOfficial="false" />
    <PackageRID Include="openbsd-x64" Platform="x64" IsOfficial="false" />
    <PackageRID Include="openbsd-arm64" Platform="arm64" IsOfficial="false" />
    <PackageRID Include="illumos-x64" Platform="x64" IsOfficial="false" />
    <PackageRID Include="solaris-x64" Platform="x64" IsOfficial="false" />
    <PackageRID Include="haiku-x64" Platform="x64" IsOfficial="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageRID Include="$(NETCoreSdkRuntimeIdentifier)" Platform="$(BuildArchitecture)" Exclude="@(PackageRID)" Condition="'$(NETCoreSdkRuntimeIdentifier)' != ''" />
    <PackageRID Include="$(TargetRid)" Platform="$(TargetArchitecture)" Exclude="@(PackageRID)" Condition="'$(TargetRid)' != ''" />
  </ItemGroup>
</Project>
