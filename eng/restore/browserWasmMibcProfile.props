<Project>
  <PropertyGroup>
    <BrowserWasmMibcProfile>$([MSBuild]::NormalizePath('$(NuGetPackageRoot)', 'optimization.browser-wasm.mibc.runtime', '$(optimizationbrowserwasmMIBCRuntimeVersion)', 'data', 'DotNet_Blazor_Wasm.mibc'))</BrowserWasmMibcProfile>
  </PropertyGroup>
