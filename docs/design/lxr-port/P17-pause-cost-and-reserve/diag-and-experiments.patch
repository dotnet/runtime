+void ImmixAllocationManager::DiagScan(size_t* out) const
+{
+    for (size_t i = 0; i < m_block_count; i++)
+    {
+        ImmixBlockState state;
+        uint8_t unavailable;
+        if (m_blocks->GetState(m_arena_start + i * ImmixBlockGeometry::BlockBytes, &state, &unavailable) !=
+            SideMetadataResult::Success)
+        {
+            continue;
+        }
+        out[static_cast<size_t>(state)]++;
+        if (state == ImmixBlockState::Reusable)
+        {
+            size_t search = 0;
+            for (;;)
+            {
+                ImmixHole hole;
+                size_t next = 0;
+                ImmixAllocationStatus status;
+                if (TryFindNextHole(m_arena_start + i * ImmixBlockGeometry::BlockBytes, search, &hole, &next, &status) !=
+                    SideMetadataResult::Success || status != ImmixAllocationStatus::Ready)
+                {
+                    break;
+                }
+                size_t n = hole.line_count;
+                size_t bucket = n <= 1 ? 0 : n <= 2 ? 1 : n <= 4 ? 2 : n <= 8 ? 3 : n <= 16 ? 4 : 5;
+                out[8 + bucket]++;
+                out[14] += n;
+                search = next;
+            }
+        }
+        if (state == ImmixBlockState::Reusable && unavailable <= ImmixBlockGeometry::LinesPerBlock)
+        {
+            size_t available = ImmixBlockGeometry::LinesPerBlock - unavailable;
+            size_t b = available == 0 ? 0 : available <= 8 ? 1 : available <= 32 ? 2 : available <= 64 ? 3 : available < 128 ? 4 : 5;
+            out[16 + b]++;
+            out[4] += available;
+            if (available >= m_minimum_reuse_lines)
+            {
+                out[5]++;
+                out[6] += available;
+            }
+        }
+    }
+    out[7] = m_minimum_reuse_lines;
+    out[15] = ImmixBlockGeometry::LineBytes;
+}
