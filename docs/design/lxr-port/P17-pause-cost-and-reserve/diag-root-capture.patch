diff --git a/src/coreclr/gc/lxr_root_diag.h b/src/coreclr/gc/lxr_root_diag.h
new file mode 100644
index 00000000000..7e9c896153c
--- /dev/null
+++ b/src/coreclr/gc/lxr_root_diag.h
@@ -0,0 +1,141 @@
+// Research only (diagnostic define LXR_ROOT_DIAG). A ring of allocation and pause events that is searched when the
+// root capture fails. It is not part of the product.
+
+#pragma once
+
+#ifdef LXR_ROOT_DIAG
+
+#include <atomic>
+#include <stdint.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+#include <time.h>
+
+struct LxrDiagEntry
+{
+    uint64_t seq;
+    uint64_t ns;
+    uint32_t tid;
+    uint32_t kind;
+    uint64_t a;
+    uint64_t b;
+    uint64_t c;
+};
+
+constexpr size_t LxrDiagRingSize = size_t{1} << 20;
+
+inline LxrDiagEntry* LxrDiagRing()
+{
+    static LxrDiagEntry* ring = new LxrDiagEntry[LxrDiagRingSize]();
+    return ring;
+}
+
+inline std::atomic<uint64_t>& LxrDiagSeq()
+{
+    static std::atomic<uint64_t> seq{1};
+    return seq;
+}
+
+inline uint64_t LxrDiagNow()
+{
+    timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<uint64_t>(ts.tv_sec) * 1000000000ull + static_cast<uint64_t>(ts.tv_nsec);
+}
+
+inline void LxrDiagLog(char kind, uint64_t a, uint64_t b = 0, uint64_t c = 0)
+{
+    static struct DeniedPrinter
+    {
+        std::atomic<uint64_t> count{0};
+        ~DeniedPrinter()
+        {
+            fprintf(stderr, "LXRDIAG denied-fresh-acquires=%llu\n", (unsigned long long)count.load());
+        }
+    } denied;
+    if (kind == 'N')
+    {
+        denied.count.fetch_add(1, std::memory_order_relaxed);
+    }
+    LxrDiagEntry* ring = LxrDiagRing();
+    uint64_t seq = LxrDiagSeq().fetch_add(1, std::memory_order_relaxed);
+    LxrDiagEntry& entry = ring[seq % LxrDiagRingSize];
+    entry.seq = 0;
+    entry.ns = LxrDiagNow();
+    entry.tid = static_cast<uint32_t>(syscall(SYS_gettid));
+    entry.kind = static_cast<uint32_t>(kind);
+    entry.a = a;
+    entry.b = b;
+    entry.c = c;
+    std::atomic_thread_fence(std::memory_order_release);
+    entry.seq = seq;
+}
+
+inline uint64_t a_block_start(uint64_t a)
+{
+    return a;
+}
+
+// Prints every entry that mentions the address (an allocation or a span that covers it) and the pause markers.
+inline void LxrDiagDump(uintptr_t object)
+{
+    uint64_t newest = LxrDiagSeq().load(std::memory_order_relaxed);
+    uint64_t oldest = newest > LxrDiagRingSize ? newest - LxrDiagRingSize + 1 : 1;
+    LxrDiagEntry* ring = LxrDiagRing();
+    uint64_t nowNs = LxrDiagNow();
+    fprintf(stderr, "LXRDIAG ring newest=%llu object=%p\n", (unsigned long long)newest, (void*)object);
+    size_t shown = 0;
+    for (uint64_t seq = oldest; seq < newest; seq++)
+    {
+        const LxrDiagEntry& e = ring[seq % LxrDiagRingSize];
+        if (e.seq != seq)
+        {
+            continue;
+        }
+        bool relevant = false;
+        switch (static_cast<char>(e.kind))
+        {
+        case 'A': // slow allocation: a=object, b=size
+        case 'C': // allocation complete: a=object, b=size, c=fast
+            relevant = object + 128 >= e.a && object < e.a + e.b + 128;
+            break;
+        case 'S': // span published: a=cursor, b=limit
+        case 'R': // span retired: a=cursor, b=limit
+            relevant = object >= e.a && object < e.b;
+            break;
+        case 'B': // block acquired: a=block, b=owner, c=source
+        case 'E': // block returned: a=block, b=owner, c=cursor
+        case 'M': // block cleared: a=block
+            relevant = object >= a_block_start(e.a) && object < a_block_start(e.a) + 0x8000;
+            break;
+        case 'H': // hole cleared: a=start, b=end
+            relevant = object >= e.a && object < e.b;
+            break;
+        case 'P': // pause suspended
+        case 'X': // scan start
+        case 'Y': // scan end
+        case 'Z': // resume
+            relevant = nowNs - e.ns < 3000000000ull;
+            break;
+        default:
+            break;
+        }
+        if (relevant)
+        {
+            if (++shown > 400)
+            {
+                break;
+            }
+            fprintf(stderr, "LXRDIAG %9llu -%8.3fms tid=%u %c a=%llx b=%llx c=%llx\n", (unsigned long long)e.seq,
+                (double)(nowNs - e.ns) / 1e6, e.tid, (char)e.kind, (unsigned long long)e.a, (unsigned long long)e.b,
+                (unsigned long long)e.c);
+        }
+    }
+    fflush(stderr);
+}
+
+#define LXR_DIAG_LOG(kind, ...) LxrDiagLog(kind, __VA_ARGS__)
+#else
+#define LXR_DIAG_LOG(kind, ...) ((void)0)
+#endif // LXR_ROOT_DIAG
