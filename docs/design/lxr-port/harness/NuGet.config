<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The harness has zero PackageReferences by design: it must restore and build with no network,
    and it must run on a bare corerun where no package resolution exists at all. Clearing the
    sources turns that from a convention into an enforced property - adding a PackageReference
    fails the restore loudly instead of quietly introducing a dependency.
  -->
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
