      "property": "sticky-zero",
      "kind": "behavior",
      "payload": "side_metadata.cpp decrement zero guard removed",
      "expected": "FAIL: zero decrement status"
    },
    {
      "id": "neighbor-increment-mask-drop",
      "property": "neighbor-atomicity",
      "kind": "behavior",
