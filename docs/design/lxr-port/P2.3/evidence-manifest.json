      "expected": "FAIL: shared-word count preserved"
    },
    {
      "id": "neighbor-store-full-word",
      "property": "neighbor-atomicity",
      "kind": "behavior",
      "payload": "side_metadata.cpp masked update writes the whole word",
      "expected": "FAIL: load count succeeds"
    },
    {
      "id": "concurrency-increment-cas-comparand",
      "property": "concurrency",
      "kind": "behavior",
      "payload": "side_metadata.cpp increment compares against the desired word",
      "expected": "FAIL: same-slot final sticky"
    },
    {
      "id": "concurrency-decrement-cas-comparand",
      "property": "concurrency",
      "kind": "behavior",
      "payload": "side_metadata.cpp decrement compares against the desired word",
      "expected": "FAIL: decrement result one"
    },
    {
      "id": "object-start-alignment",
      "property": "object-starts",
      "kind": "behavior",
      "payload": "reference_count.cpp drops the 8-byte alignment guard",
      "expected": "FAIL: misaligned byref rejected"
    },
    {
      "id": "object-start-registration",
      "property": "object-starts",
      "kind": "behavior",
      "payload": "reference_count.cpp accepts an unregistered start",
      "expected": "FAIL: unregistered exact start rejected"
    },
    {
      "id": "straddle-includes-first-line",
      "property": "straddle-range",
      "kind": "behavior",
      "payload": "reference_count.cpp continuation range starts at the object line",
      "expected": "FAIL: mark straddle lines"
    },
    {
      "id": "straddle-includes-partial-tail",
      "property": "straddle-range",
      "kind": "behavior",
      "payload": "reference_count.cpp continuation range rounds the end up",
      "expected": "FAIL: following line is not continuation"
    },
    {
      "id": "sentinel-missing-straddle-bit",
      "property": "sentinel-pair",
      "kind": "behavior",
