<Project Sdk="Microsoft.NET.Sdk" DefaultTargets="Publish;PublishItemsOutputGroup">

  <PropertyGroup>
    <RuntimeIdentifier>$(PortableTargetRid)</RuntimeIdentifier>
    <PublishDir>$(CoreclrRuntimeBinDir)managed-ildasm</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <AotOrSingleFile>true</AotOrSingleFile>
    <HostBundleIdentifier>com.microsoft.dotnet.ildasm</HostBundleIdentifier>
    <HostBundleName>ildasm</HostBundleName>
    <UseBootstrapLayout Condition="'$(UseBootstrap)' == 'true'">true</UseBootstrapLayout>
  </PropertyGroup>

  <Import Project="ildasm.props" />
  <Import Project="$(CoreClrProjectRoot)tools\aot\NativeAotToolRuntimeSettings.props" />

</Project>
