<Project>
  <!--
    CoreCLR counterpart of BrowserWasmApp.props. The two are mutually exclusive: the workload
    pack (Microsoft.NET.Runtime.WebAssembly.Sdk/Sdk/Sdk.targets.in) imports this one alongside
    BrowserWasmApp.CoreCLR.targets, and the Mono one alongside BrowserWasmApp.targets.

    Only the flavor-neutral properties are repeated here. In particular the Mono app-build
    target lists from WasmApp.Common.props (WasmBuildAppDependsOn, WasmNestedPublishAppDependsOn)
    are deliberately not set: they name targets defined in WasmApp.Common.targets, which the
    CoreCLR path does not import, and BrowserWasmApp.CoreCLR.targets defines its own equivalents.
  -->
  <PropertyGroup>
    <TargetOS>browser</TargetOS>
    <TargetArchitecture>wasm</TargetArchitecture>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
  </PropertyGroup>
</Project>
