{
  "version": "${WorkloadVersion}",
  "depends-on": {
    "Microsoft.NET.Workload.Emscripten.Current": "${EmscriptenVersion}"
  },
  "workloads": {
    "wasm-tools": {
      "description": ".NET WebAssembly build tools for ${NetVersion}.0",
      "packs": [
        "Microsoft.NET.Runtime.WebAssembly.Sdk.${NetVersion}",
        "Microsoft.NET.Sdk.WebAssembly.Pack.${NetVersion}"
      ],
      "extends": [ "microsoft-net-sdk-emscripten" ],
      "platforms": [ "win-x64", "win-arm64", "linux-x64", "linux-arm64", "linux-musl-x64", "linux-musl-arm64", "osx-x64", "osx-arm64" ]
    },
    "wasm-experimental": {
      "description": ".NET WebAssembly experimental tooling for ${NetVersion}.0",
      "packs": [
        "Microsoft.NET.Runtime.WebAssembly.Templates.${NetVersion}"
      ],
      "extends": [ "wasm-tools" ],
      "platforms": [ "win-x64", "win-arm64", "linux-x64", "linux-arm64", "linux-musl-x64", "linux-musl-arm64", "osx-x64", "osx-arm64" ]
    },
    "wasi-experimental": {
      "description": ".NET WASI experimental tooing for for ${NetVersion}.0",
      "packs": [
        "Microsoft.NET.Runtime.WebAssembly.Wasi.Sdk.${NetVersion}",
        "Microsoft.NETCore.App.Runtime.${NetVersion}.wasi-wasm",
        "Microsoft.NET.Runtime.WebAssembly.Templates.${NetVersion}"
      ],
      "extends": [ "microsoft-net-runtime-mono-tooling" ],
      "platforms": [ "win-x64", "win-arm64", "linux-x64", "linux-arm64", "linux-musl-x64", "linux-musl-arm64", "osx-x64", "osx-arm64" ]
    },
    "mobile-librarybuilder": {
      "description": "Mobile SDK for building a self-contained .NET native library in ${NetVersion}.0",
      "packs": [
        "Microsoft.NET.Runtime.LibraryBuilder.Sdk.${NetVersion}"
      ],
      "extends": [ "microsoft-net-runtime-mono-tooling" ],
      "platforms": [ "win-x64", "win-arm64", "osx-x64", "osx-arm64" ]
    },
    "microsoft-net-runtime-android": {
      "abstract": true,
      "description": "Android runtime tooling",
      "extends": [ "microsoft-net-runtime-mono-tooling" ],
      "platforms": [ "win-x64", "win-arm64", "linux-x64", "linux-arm64", "osx-x64", "osx-arm64" ]
    },
    "microsoft-net-runtime-android-aot": {
      "abstract": true,
      "description": "Android runtime tooling",
      "extends": [ "microsoft-net-runtime-android" ],
      "platforms": [ "win-x64", "win-arm64", "linux-x64", "linux-arm64", "osx-x64", "osx-arm64" ]
    },
    "microsoft-net-runtime-ios": {
      "abstract": true,
      "description": "iOS runtime tooling",
      "extends": [ "runtimes-ios" ],
      "platforms": [ "win-x64", "win-arm64", "osx-arm64", "osx-x64" ]
    },
    "runtimes-ios": {
      "abstract": true,
      "description": "iOS runtime tooling",
      "extends": [ "microsoft-net-runtime-mono-tooling" ],
      "platforms": [ "win-x64", "win-arm64", "osx-arm64", "osx-x64" ]
    },
    "microsoft-net-runtime-maccatalyst": {
      "abstract": true,
      "description": "MacCatalyst runtime tooling",
      "extends": [ "runtimes-maccatalyst" ],
      "platforms": [ "win-x64", "win-arm64", "osx-arm64", "osx-x64" ]
    },
    "runtimes-maccatalyst": {
      "abstract": true,
      "description": "MacCatalyst runtime tooling",
      "extends": [ "microsoft-net-runtime-mono-tooling" ],
      "platforms": [ "win-x64", "win-arm64", "osx-arm64", "osx-x64" ]
    },
    "microsoft-net-runtime-macos": {
      "abstract": true,
      "description": "MacOS CoreCLR Runtime Workload",
      "packs": [
        "Microsoft.NETCore.App.Runtime.${NetVersion}.osx-arm64",
        "Microsoft.NETCore.App.Runtime.${NetVersion}.osx-x64"
      ],
      "extends": [ "microsoft-net-runtime-mono-tooling" ],
      "platforms": [ "osx-arm64", "osx-x64" ]
    },
    "microsoft-net-runtime-tvos": {
      "abstract": true,
      "description": "tvOS runtime tooling",
      "extends": [ "runtimes-tvos" ],
      "platforms": [ "win-x64", "win-arm64", "osx-arm64", "osx-x64" ]
    },
    "runtimes-tvos": {
      "abstract": true,
      "description": "tvOS runtime tooling",
      "extends": [ "microsoft-net-runtime-mono-tooling" ],
      "platforms": [ "win-x64", "win-arm64", "osx-arm64", "osx-x64" ]
    },
    "microsoft-net-runtime-mono-tooling": {
      "abstract": true,
      "description": "Shared native build tooling for Mono runtime",
      "packs": [
        "Microsoft.NET.Runtime.MonoTargets.Sdk.${NetVersion}"
      ]
    }
  },
  "packs": {
    "Microsoft.NET.Runtime.MonoTargets.Sdk.${NetVersion}": {
      "kind": "Sdk",
      "version": "${PackageVersion}",
      "alias-to": {
        "any": "Microsoft.NET.Runtime.MonoTargets.Sdk"
      }
    },
    "Microsoft.NET.Runtime.LibraryBuilder.Sdk.${NetVersion}": {
      "kind": "Sdk",
      "version": "${PackageVersion}",
      "alias-to": {
        "any": "Microsoft.NET.Runtime.LibraryBuilder.Sdk"
      }
    },
    "Microsoft.NET.Runtime.WebAssembly.Sdk.${NetVersion}": {
      "kind": "Sdk",
      "version": "${PackageVersion}",
      "alias-to": {
        "any": "Microsoft.NET.Runtime.WebAssembly.Sdk"
      }
    },
    "Microsoft.NET.Sdk.WebAssembly.Pack.${NetVersion}": {
      "kind": "library",
      "version": "${PackageVersion}",
      "alias-to": {
        "any": "Microsoft.NET.Sdk.WebAssembly.Pack"
      }
    },
    "Microsoft.NET.Runtime.WebAssembly.Wasi.Sdk.${NetVersion}": {
      "kind": "Sdk",
      "version": "${PackageVersion}",
      "alias-to": {
        "any": "Microsoft.NET.Runtime.WebAssembly.Wasi.Sdk"
      }
    },
    "Microsoft.NET.Runtime.WebAssembly.Templates.${NetVersion}": {
      "kind": "template",
      "version": "${PackageVersion}"
    },
    "Microsoft.NETCore.App.Runtime.${NetVersion}.osx-arm64": {
      "kind": "framework",
      "version": "${PackageVersion}",
      "alias-to": {
        "any": "Microsoft.NETCore.App.Runtime.osx-arm64"
      }
    },
    "Microsoft.NETCore.App.Runtime.${NetVersion}.osx-x64": {
      "kind": "framework",
      "version": "${PackageVersion}",
      "alias-to": {
          "any": "Microsoft.NETCore.App.Runtime.osx-x64"
      }
    },
    "Microsoft.NETCore.App.Runtime.${NetVersion}.browser-wasm" : {
      "kind": "framework",
      "version": "${PackageVersion}",
      "alias-to": {
        "any": "Microsoft.NETCore.App.Runtime.browser-wasm"
      }
    },
    "Microsoft.NETCore.App.Runtime.${NetVersion}.wasi-wasm" : {
      "kind": "framework",
      "version": "${PackageVersion}",
      "alias-to": {
        "any": "Microsoft.NETCore.App.Runtime.wasi-wasm"
      }
    }
  }
}
