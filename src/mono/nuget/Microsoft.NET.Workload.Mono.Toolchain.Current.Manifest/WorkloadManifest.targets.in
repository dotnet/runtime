<Project TreatAsLocalProperty="UseMonoRuntime">
  <PropertyGroup>
    <_RuntimePackInWorkloadVersionCurrent>${PackageVersion}</_RuntimePackInWorkloadVersionCurrent>

    <TargetsCurrent Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and $([MSBuild]::VersionEquals('$(TargetFrameworkVersion)', '${FrameworkVersionCurrent}'))">true</TargetsCurrent>
    <UseMonoRuntime Condition="'$(TargetsCurrent)' == 'true'">false</UseMonoRuntime>
  </PropertyGroup>

  <!-- Runtime feature defaults to trim unnecessary code -->
  <Import Project="$(MSBuildThisFileDirectory)WasmFeatures.props"
          Condition="'$(TargetsCurrent)' == 'true' and ('$(RuntimeIdentifier)' == 'browser-wasm' or '$(RuntimeIdentifier)' == 'wasi-wasm')" />

  <PropertyGroup Condition="'$(TargetsCurrent)' == 'true' and '$(RuntimeIdentifier)' == 'browser-wasm'">
    <WasmNativeWorkloadAvailable>$(WasmNativeWorkload12)</WasmNativeWorkloadAvailable>
    <WasmNativeWorkloadAvailable Condition="'$(WasmNativeWorkloadAvailable)' == '' or '$(WasmNativeWorkload)' == 'false'">false</WasmNativeWorkloadAvailable>
    <WasmNativeWorkload>$(WasmNativeWorkloadAvailable)</WasmNativeWorkload>
    <_WasmNativeWorkloadNeeded Condition="
        '$(WasmEnableSIMD)' == 'false' or
        '$(WasmEnableExceptionHandling)' == 'false' or
        '$(InvariantTimezone)' == 'true' or
        '$(WasmNativeStrip)' == 'false' or
        '$(WasmNativeDebugSymbols)' == 'true' or
        '$(WasmSingleFileBundle)' == 'false' or
        '$(RunAOTCompilation)' == 'true' or
        '$(WasmBuildNative)' == 'true' or
        '$(EmccInitialHeapSize)' != '' or
        '$(EmccMaximumHeapSize)' != '' " >true</_WasmNativeWorkloadNeeded>
    <!-- Not a relink trigger: CoreCLR runs wasm-opt from the workload's Emscripten SDK over the relinked runtime
         and over ReadyToRun images, so requesting it requires the workload. -->
    <_WasmNativeWorkloadNeeded Condition="'$(WasmRunWasmOpt)' == 'true'">true</_WasmNativeWorkloadNeeded>

    <UsingBrowserRuntimeWorkload Condition="'$(UsingBrowserRuntimeWorkload)' == '' and '$(_WasmNativeWorkloadNeeded)' == 'true'">true</UsingBrowserRuntimeWorkload>
    <UsingBrowserRuntimeWorkload Condition="'$(UsingBrowserRuntimeWorkload)' == ''">$(WasmNativeWorkloadAvailable)</UsingBrowserRuntimeWorkload>
  </PropertyGroup>

  <!-- Trigger the workload acquisition flow when CoreCLR native items require it. -->
  <PropertyGroup>
    <_WasmCoreCLRNativeItemsNeedWorkload Condition="'$(RuntimeIdentifier)' == 'browser-wasm' and '$(TargetsCurrent)' == 'true' and '$(UseMonoRuntime)' == 'false' and
                                                     '$(UsingBrowserRuntimeWorkload)' != 'true' and '$(_BrowserWorkloadDisabled)' != 'true'">true</_WasmCoreCLRNativeItemsNeedWorkload>
  </PropertyGroup>
  <ItemGroup Condition="'$(_WasmCoreCLRNativeItemsNeedWorkload)' == 'true'">
    <MissingWorkloadPack Include="Microsoft.NET.Runtime.WebAssembly.Sdk.${NetVersion}"
                         Condition="@(NativeFileReference->Count()) > 0 or @(NativeLibrary->Count()) > 0 or @(DirectPInvoke->Count()) > 0 or @(DirectPInvokeList->Count()) > 0" />
  </ItemGroup>
  <Target Name="_WasmAddMissingWorkloadPackForNativeItems"
          BeforeTargets="_CheckForMissingWorkload;GetSuggestedWorkloads"
          Condition="'$(_WasmCoreCLRNativeItemsNeedWorkload)' == 'true' and
                     (@(NativeFileReference->Count()) > 0 or @(NativeLibrary->Count()) > 0 or @(DirectPInvoke->Count()) > 0 or @(DirectPInvokeList->Count()) > 0)">
    <ItemGroup>
      <MissingWorkloadPack Include="Microsoft.NET.Runtime.WebAssembly.Sdk.${NetVersion}" Exclude="@(MissingWorkloadPack)" />
    </ItemGroup>
  </Target>

  <PropertyGroup Condition="'$(TargetsCurrent)' == 'true' and '$(RuntimeIdentifier)' == 'wasi-wasm'">
    <WasiNativeWorkloadAvailable>$(WasiNativeWorkload12)</WasiNativeWorkloadAvailable>
    <WasiNativeWorkloadAvailable Condition="'$(WasiNativeWorkloadAvailable)' == '' or '$(WasiNativeWorkload)' == 'false'">false</WasiNativeWorkloadAvailable>
    <WasiNativeWorkload>$(WasiNativeWorkloadAvailable)</WasiNativeWorkload>
    <UsingWasiRuntimeWorkload Condition="'$(UsingWasiRuntimeWorkload)' == ''">$(WasiNativeWorkloadAvailable)</UsingWasiRuntimeWorkload>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetsCurrent)' == 'true' and
                            '$(RuntimeIdentifier)' == 'browser-wasm' and
                            ('$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true' or '$(UsingMicrosoftNETSdkWebAssembly)' == 'true') and
                            '$(UsingBrowserRuntimeWorkload)' == 'true'">
    <UsingBlazorAOTWorkloadManifest>true</UsingBlazorAOTWorkloadManifest>
  </PropertyGroup>

  <!-- Support for "browser" target platform identifier -->
  <PropertyGroup Condition="'$(TargetsCurrent)' == 'true' and '$(TargetPlatformIdentifier)' == 'browser'">
    <TargetPlatformSupported>true</TargetPlatformSupported>
    <TargetPlatformVersion Condition="'$(TargetPlatformVersion)' == ''">1.0</TargetPlatformVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetsCurrent)' == 'true' and '$(TargetPlatformIdentifier)' == 'browser'">
    <SdkSupportedTargetPlatformVersion Include="1.0" />
  </ItemGroup>

  <!-- Support for "wasi" target platform identifier -->
  <PropertyGroup Condition="'$(TargetsCurrent)' == 'true' and '$(TargetPlatformIdentifier)' == 'wasi'">
    <TargetPlatformSupported>true</TargetPlatformSupported>
    <TargetPlatformVersion Condition="'$(TargetPlatformVersion)' == ''">1.0</TargetPlatformVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetsCurrent)' == 'true' and '$(TargetPlatformIdentifier)' == 'wasi'">
    <SdkSupportedTargetPlatformVersion Include="1.0" />
  </ItemGroup>

  <!-- end of common logic -->

  <!-- Current TFM-specific workload imports -->

  <!-- CoreCLR uses WebAssembly.Sdk for native builds.
       The .NET SDK resolves the runtime and crossgen2 packs. -->
  <ImportGroup Condition="'$(TargetsCurrent)' == 'true' and '$(RuntimeIdentifier)' == 'browser-wasm' and '$(UsingBrowserRuntimeWorkload)' == 'true'">
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Runtime.WebAssembly.Sdk.${NetVersion}" />
    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Runtime.WebAssembly.Sdk.${NetVersion}" />
  </ImportGroup>

  <ImportGroup Condition="'$(TargetsCurrent)' == 'true' and '$(RuntimeIdentifier)' == 'wasi-wasm' and '$(UsingWasiRuntimeWorkload)' == 'true' and '$(PublishAot)' != 'true'">
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Runtime.WebAssembly.Wasi.Sdk.${NetVersion}" />
    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Runtime.WebAssembly.Wasi.Sdk.${NetVersion}" />
  </ImportGroup>

  <ItemGroup Condition="'$(TargetsCurrent)' == 'true' and
                        ('$(RuntimeIdentifier)' == 'browser-wasm' or
                         '$(RuntimeIdentifier)' == 'wasi-wasm')">
    <KnownFrameworkReference Update="Microsoft.NETCore.App">
      <TargetingPackVersion Condition="'%(KnownFrameworkReference.TargetFramework)' == '${NetVersion}.0'">$(_RuntimePackInWorkloadVersionCurrent)</TargetingPackVersion>
      <LatestRuntimeFrameworkVersion Condition="'%(KnownFrameworkReference.TargetFramework)' == '${NetVersion}.0'">$(_RuntimePackInWorkloadVersionCurrent)</LatestRuntimeFrameworkVersion>
    </KnownFrameworkReference>
    <KnownCrossgen2Pack Update="@(KnownCrossgen2Pack)">
      <Crossgen2PackVersion Condition="'%(KnownCrossgen2Pack.TargetFramework)' == '${NetVersion}.0'">$(_RuntimePackInWorkloadVersionCurrent)</Crossgen2PackVersion>
    </KnownCrossgen2Pack>
    <KnownWebAssemblySdkPack Update="@(KnownWebAssemblySdkPack)">
      <WebAssemblySdkPackVersion Condition="'%(KnownWebAssemblySdkPack.TargetFramework)' == '${NetVersion}.0'">$(_RuntimePackInWorkloadVersionCurrent)</WebAssemblySdkPackVersion>
    </KnownWebAssemblySdkPack>
  </ItemGroup>


</Project>
