<!--
***********************************************************************************************
Microsoft.NET.Sdk.WebAssembly.Browser.CoreCLR.targets

ReadyToRun for CoreCLR browser-wasm. See dotnet/runtime#121257 for the full design.
MUST be a .targets (not .props) and import on '== false' (not '!= true'): the WasmSdk defaults
UseMonoRuntime=true (SDK Sdk.props), so CoreCLR is the explicit '== false' opt-in.

Copyright (c) .NET Foundation. All rights reserved.
***********************************************************************************************
-->
<Project>

  <!-- Default OFF for now. Flipping to true belongs to the codegen-quality / crossgen2-resolution work
       stream (dotnet/runtime#132466), not here. Consumers opt in with -p:PublishReadyToRun=true. -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">false</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishReadyToRun)' == 'true'">
    <!-- Override only the incompatible SDK default: net11+ defaults ContainerFormat=pe (unloadable on wasm).
         An explicit unsupported value is left as-is and rejected by _WasmCoreClrSelectR2RDirectories. -->
    <PublishReadyToRunContainerFormat Condition="'$(PublishReadyToRunContainerFormat)' == '' or '$(PublishReadyToRunContainerFormat)' == 'pe'">wasm</PublishReadyToRunContainerFormat>
    <!-- Default non-composite when unset; an explicit composite request is rejected below. -->
    <PublishReadyToRunComposite Condition="'$(PublishReadyToRunComposite)' == ''">false</PublishReadyToRunComposite>
    <!-- Compile every assembly into one shared (large) version bubble. -->
    <PublishReadyToRunCrossgen2ExtraArgs>$(PublishReadyToRunCrossgen2ExtraArgs);--opt-cross-module:*</PublishReadyToRunCrossgen2ExtraArgs>
    <!-- NYI/SIMD methods crossgen2 can't emit into R2R fall back to the runtime JIT. -->
    <PublishReadyToRunCrossgen2ExtraArgs>$(PublishReadyToRunCrossgen2ExtraArgs);--codegenopt:JitWasmNyiToR2RUnsupported=1;--codegenopt:JitWasmSimdNyiToR2RUnsupported=1</PublishReadyToRunCrossgen2ExtraArgs>
  </PropertyGroup>

  <!-- Prebuilt R2R probe dir for ConvertDllsToWebcil (see dotnet/runtime#121257). Webcil staging is the
       managed pipeline and is independent of the native relink (which WasmBuildOnlyAfterPublish gates).
       PublishTrimmed is NOT consulted here: publish always crossgens the WHOLE closure (trimmed or untrimmed),
       so the framework + app R2R both come from the per-app crossgen output (obj/R2R). Only the dev-loop build
       differs: it never trims and never crossgens, so its BCL comes from the untrimmed runtime-pack R2R images
       and the app ships as IL. 'Under publish' = _IsPublishing (outer `dotnet publish`),
       WasmBuildingForNestedPublish (the nested crossgen worker), or WasmBuildOnlyAfterPublish (the library-test
       flow whose outer build serves the per-app R2R the nested publish produced). _WasmRuntimePackR2RDir is set
       here (target time) because _RuntimePackNativeDir is only set by _ResolveGlobalizationConfiguration. -->
  <Target Name="_WasmCoreClrSelectR2RDirectories"
          DependsOnTargets="_ResolveWasmConfiguration">
    <PropertyGroup>
      <_WasmRuntimePackR2RDir Condition="'$(_WasmRuntimePackR2RDir)' == '' and '$(_RuntimePackNativeDir)' != ''">$([MSBuild]::NormalizeDirectory('$(_RuntimePackNativeDir)', 'r2r'))</_WasmRuntimePackR2RDir>
      <!-- Computed unconditionally: the trimmed-closure restriction below needs it with ReadyToRun off too. -->
      <_WasmCoreClrUnderPublish Condition="'$(_IsPublishing)' == 'true' or '$(WasmBuildingForNestedPublish)' == 'true' or '$(WasmBuildOnlyAfterPublish)' == 'true'">true</_WasmCoreClrUnderPublish>
    </PropertyGroup>
    <PropertyGroup Condition="'$(PublishReadyToRun)' == 'true'">
      <!-- Match the SDK crossgen output dir casing exactly (_ReadyToRunOutputPath = $(IntermediateOutputPath)R2R);
           a lowercase 'r2r' stages nothing on case-sensitive filesystems. -->
      <_WasmPublishR2RDir Condition="'$(_WasmPublishR2RDir)' == ''">$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)', 'R2R'))</_WasmPublishR2RDir>
      <!-- Publish always crossgens the whole closure: BCL + app from the per-app R2R (obj/R2R). -->
      <_WasmPublishPrebuiltR2RDirectory>$(_WasmPublishR2RDir)</_WasmPublishPrebuiltR2RDirectory>
      <!-- Under publish the build sub-phase mirrors the publish selection so it is superseded cleanly;
           the dev-loop build (neither) sources the BCL from the untrimmed pack R2R and ships the app as IL. -->
      <_WasmBuildPrebuiltR2RDirectory Condition="'$(_WasmCoreClrUnderPublish)' == 'true'">$(_WasmPublishR2RDir)</_WasmBuildPrebuiltR2RDirectory>
      <_WasmBuildPrebuiltR2RDirectory Condition="'$(_WasmCoreClrUnderPublish)' != 'true'">$(_WasmRuntimePackR2RDir)</_WasmBuildPrebuiltR2RDirectory>
    </PropertyGroup>
  </Target>

  <!-- Fail comprehensibly instead of silently emitting composite/PE images the runtime can't load, or (out of
       tree, before dotnet/sdk#55785) letting the base SDK emit composite R2R that fails coreclr_initialize with
       0x80131018 at startup. The config checks run on both build and publish; the crossgen2 requirement is
       publish-only: a dev-loop build stages the pack R2R and never invokes crossgen2. -->
  <Target Name="_WasmCoreClrValidateReadyToRun"
          Condition="'$(PublishReadyToRun)' == 'true'"
          BeforeTargets="_WasmCoreClrSelectR2RDirectories">
    <Error Condition="'$(PublishReadyToRunComposite)' == 'true'"
           Text="PublishReadyToRunComposite is not supported for CoreCLR browser-wasm; only non-composite (per-assembly) R2R images are supported." />
    <Error Condition="'$(PublishReadyToRunContainerFormat)' != 'wasm'"
           Text="PublishReadyToRunContainerFormat '$(PublishReadyToRunContainerFormat)' is not supported for CoreCLR browser-wasm; only 'wasm' is supported." />
    <Error Condition="('$(_IsPublishing)' == 'true' or '$(WasmBuildingForNestedPublish)' == 'true' or '$(WasmBuildOnlyAfterPublish)' == 'true') and ('$(Crossgen2InBuildDir)' == '' or !Exists('$(Crossgen2InBuildDir)')) and '@(ResolvedCrossgen2Pack)' == ''"
           Text="PublishReadyToRun=true for CoreCLR browser-wasm requires a wasm-capable crossgen2, but none was resolved. Set Crossgen2InBuildDir to an in-build crossgen2 directory (or provide a ResolvedCrossgen2Pack) until wasm crossgen2 support flows through the base SDK (dotnet/sdk#55785)." />
  </Target>

  <!-- The nested publish shares $(OutDir) with the outer build, and its build-phase webcil conversion
       (_ConvertBuildDllsToWebcil) necessarily runs before ILLink and crossgen, so it stages the UNTRIMMED
       framework. When the consumer copies framework assets to the output directory (library tests set
       _WasmFrameworkCopyToOutputDirectory, because they are served from bin/ by a plain file server rather
       than the static web assets middleware), that untrimmed IL set lands in the served _framework beside the
       outer build's trimmed R2R set: two fingerprinted copies of every trimmed assembly and a mixed version
       bubble the runtime MVID check rejects. Only the outer build should populate the served directory.
       The property alone is not enough: the xharness runner set injected by
       AddTestRunnersToReferenceCopyLocalPaths carries its own CopyToOutputDirectory, which
       DefineStaticWebAssets prefers over its parameter, so those untrimmed copies would still be staged
       (observed as 5 duplicate runner assemblies beside their trimmed counterparts). Hence the item metadata
       too - _WasmCoreClrRestoreCopyToOutputDirectory undoes it on the way back out. -->
  <Target Name="_WasmCoreClrSuppressNestedPublishAssetCopy"
          Condition="'$(WasmBuildingForNestedPublish)' == 'true'"
          BeforeTargets="_ComputeWasmBuildCandidates">
    <PropertyGroup>
      <_WasmFrameworkCopyToOutputDirectory>Never</_WasmFrameworkCopyToOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <ReferenceCopyLocalPaths CopyToOutputDirectory="Never" />
    </ItemGroup>
  </Target>

  <!-- CopyToOutputDirectory set by the target above is STICKY: a native relink (or AOT) returns the nested
       publish's assembly set to the outer build, metadata included, and DefineStaticWebAssets prefers per-item
       metadata over its parameter. The outer build would then define those assets in the manifest yet never
       copy them, so the boot config requests a fingerprint that is not on disk and startup fails on a 500.
       Restore the outer build's own value before its assets are computed. -->
  <Target Name="_WasmCoreClrRestoreCopyToOutputDirectory"
          Condition="'$(_WasmEnableWebcil)' == 'true' and '$(WasmBuildingForNestedPublish)' != 'true'"
          BeforeTargets="_ComputeWasmBuildCandidates">
    <ItemGroup>
      <ReferenceCopyLocalPaths Condition="'%(ReferenceCopyLocalPaths.CopyToOutputDirectory)' == 'Never'"
                               CopyToOutputDirectory="$(_WasmFrameworkCopyToOutputDirectory)" />
      <WasmAssembliesFinal Condition="'%(WasmAssembliesFinal.CopyToOutputDirectory)' == 'Never'"
                           CopyToOutputDirectory="$(_WasmFrameworkCopyToOutputDirectory)" />
    </ItemGroup>
  </Target>

  <!-- PublishTrimmed selects the staged closure (untrimmed pack vs linker output) exactly like
       PublishReadyToRun selects its flavour, so it belongs in the webcil staging stamp too. -->
  <ItemGroup>
    <_WasmWebcilStampProperty Include="PublishTrimmed" />
  </ItemGroup>

  <!-- The webcil stamp only forces RE-CONVERSION; it never removes what the previous mode left behind.
       Flipping PublishReadyToRun, PublishTrimmed or the native flags changes what the derived outputs should
       be (pack R2R vs per-app R2R vs plain IL, untrimmed pack vs trimmed closure, runtime-pack native vs
       relinked), yet those outputs are keyed on file timestamps: stale per-app images survive in obj/R2R
       (where they also make crossgen2 fail writing over a still-mapped file), and because static web assets
       are content-fingerprinted the newly staged copies land BESIDE the old ones in the served directory
       instead of replacing them - two copies of an assembly from two different version bubbles, which the
       runtime MVID check rejects or hangs on. Record the mode and drop the derived outputs whenever it
       changes.
       Only the outer pass may own the stamp. The nested publish worker shares this IntermediateOutputPath but
       resolves WasmNativeStrip and WasmNativeDebugSymbols differently (their SDK defaults test
       WasmBuildingForNestedPublish), so letting it run too makes the two passes disagree on the mode string
       and take turns rewriting the stamp, each wiping what the other just staged. The outer pass runs first
       anyway, ahead of both its own webcil conversion and the nested publish's crossgen, so nothing is lost. -->
  <Target Name="_WasmCoreClrInvalidateStaleModeOutputs"
          Condition="'$(_WasmEnableWebcil)' == 'true' and '$(WasmBuildingForNestedPublish)' != 'true'"
          BeforeTargets="_ComputeWasmBuildCandidates;_PrepareForReadyToRunCompilation">
    <PropertyGroup>
      <_WasmCoreClrModeStamp>$(IntermediateOutputPath)wasm-coreclr-mode.stamp</_WasmCoreClrModeStamp>
      <_WasmCoreClrMode>PublishReadyToRun=$(PublishReadyToRun);PublishTrimmed=$(PublishTrimmed);WasmBuildNative=$(WasmBuildNative);WasmNativeDebugSymbols=$(WasmNativeDebugSymbols);WasmNativeStrip=$(WasmNativeStrip)</_WasmCoreClrMode>
      <!-- Only clear the served directory when it is the default one: WasmRuntimeAssetsLocation may be './',
           where the app's own content sits next to the staged assets and a recursive delete would take it. -->
      <_WasmCoreClrServedAssetsDir Condition="'$(WasmRuntimeAssetsLocation)' == '' or '$(WasmRuntimeAssetsLocation)' == '_framework'">$(OutDir)wwwroot\_framework\</_WasmCoreClrServedAssetsDir>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_WasmCoreClrModeStamp)" Condition="Exists('$(_WasmCoreClrModeStamp)')">
      <Output TaskParameter="Lines" ItemName="_WasmCoreClrPreviousMode" />
    </ReadLinesFromFile>
    <ItemGroup Condition="'@(_WasmCoreClrPreviousMode)' != '' and '@(_WasmCoreClrPreviousMode)' != '$(_WasmCoreClrMode)'">
      <_WasmCoreClrStaleModeOutput Include="$(IntermediateOutputPath)R2R\*.wasm" />
      <_WasmCoreClrStaleModeOutput Include="$(IntermediateOutputPath)webcil\**\*.wasm" />
      <!-- Just the link outputs, not the .o files: the emcc link rsp is an Input to the link target, so only
           that step has to re-run for a native flag change. -->
      <_WasmCoreClrStaleModeOutput Include="$(IntermediateOutputPath)wasm\for-build\dotnet.native.*" />
      <_WasmCoreClrStaleModeOutput Include="$(IntermediateOutputPath)wasm\for-publish\dotnet.native.*" />
      <!-- Everything staged, managed and native alike: these are content-fingerprinted, so a re-stage adds a
           new name beside the old file instead of replacing it. All of it is re-copied on the next build. -->
      <_WasmCoreClrStaleModeOutput Include="$(_WasmCoreClrServedAssetsDir)**\*" Condition="'$(_WasmCoreClrServedAssetsDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_WasmCoreClrStaleModeOutput)" ContinueOnError="true" />
    <WriteLinesToFile File="$(_WasmCoreClrModeStamp)" Lines="$(_WasmCoreClrMode)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_WasmCoreClrModeStamp)" />
    </ItemGroup>
  </Target>

  <!-- Prune raw pack R2R images (native/r2r/*.wasm) from build copy-local so the 90 MB closure never lands
       loose in bin/; the managed .dll stays and ConvertDllsToWebcil stages the image. The _WasmRuntimePackR2RDir
       check stays at the item level: it is computed by the DependsOnTargets below, so it can't gate the target. -->
  <Target Name="_WasmCoreClrPrunePackR2RFromBuild"
          Condition="'$(_WasmEnableWebcil)' == 'true'"
          DependsOnTargets="_WasmCoreClrSelectR2RDirectories"
          BeforeTargets="_ComputeWasmBuildCandidates">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Extension)' == '.wasm' and '$(_WasmRuntimePackR2RDir)' != '' and Exists('$(_WasmRuntimePackR2RDir)%(FileName).wasm')" />
    </ItemGroup>
  </Target>

  <!-- In any trimmed publish-flow build (_WasmCoreClrUnderPublish: an outer publish, a nested publish worker,
       or the WasmBuildOnlyAfterPublish library-test flow) the served bundle must contain ONLY the linker's
       trimmed app closure, sourced from the trimmed output. The runtime pack copy-local set carries every
       shared-framework assembly (~196); the trimmed closure is a small subset (e.g. ~43). Serving the two
       mixed is wrong with or without ReadyToRun: with R2R it also mixes untrimmed-pack and trimmed-per-app
       version bubbles so the runtime MVID check faults at startup, and either way an untrimmed assembly can
       call a member ILLink removed from the trimmed framework (MissingMethodException).
       Keep only assemblies present in the linker output and repoint each at its trimmed IL: ConvertDllsToWebcil
       still stages the per-app R2R image (_WasmBuildPrebuiltR2RDirectory = obj/R2R) for the crossgen'd members
       and PE-converts the trimmed IL for the NYI-fallback (IL-only) members, so every served webcil pins the
       same trimmed MVIDs. The _WasmCoreClrUnderPublish test stays at item level because it is computed by the
       _WasmCoreClrSelectR2RDirectories DependsOnTarget (gating the target on it would skip the target before it
       runs). Scoped to the outer build (WasmBuildingForNestedPublish != true): the nested publish worker owns
       the trimming itself, and rewriting its ReferenceCopyLocalPaths ahead of ILLink would corrupt the link.
       No-op when the linker has not run (Exists guard), leaving the untrimmed pack behavior unchanged. -->
  <Target Name="_WasmCoreClrRestrictBuildToTrimmedClosure"
          Condition="'$(_WasmEnableWebcil)' == 'true' and '$(PublishTrimmed)' == 'true'"
          DependsOnTargets="_WasmCoreClrSelectR2RDirectories"
          BeforeTargets="_ComputeWasmBuildCandidates">
    <PropertyGroup>
      <_WasmTrimmedClosureDir Condition="'$(_WasmTrimmedClosureDir)' == '' and '$(IntermediateLinkDir)' != ''">$(IntermediateLinkDir)</_WasmTrimmedClosureDir>
      <_WasmTrimmedClosureDir Condition="'$(_WasmTrimmedClosureDir)' == ''">$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)', 'linked'))</_WasmTrimmedClosureDir>
      <!-- A native relink (or AOT) returns the final, already trimmed assembly set from the nested publish,
           project assembly included. Only the plain managed path leaves it empty and falls back to the
           untrimmed IntermediateAssembly, so only that path needs the repoint below. -->
      <_WasmCoreClrHasFinalAssemblies Condition="'@(WasmAssembliesFinal)' != ''">true</_WasmCoreClrHasFinalAssemblies>
    </PropertyGroup>
    <ItemGroup Condition="'$(_WasmCoreClrUnderPublish)' == 'true' and '$(WasmBuildingForNestedPublish)' != 'true' and Exists('$(_WasmTrimmedClosureDir)')">
      <!-- Tag every copy-local item with trimmed-closure membership (default false so the metadata is always
           defined), then set true for managed assemblies the linker kept. -->
      <ReferenceCopyLocalPaths>
        <_WasmInTrimmedClosure>false</_WasmInTrimmedClosure>
      </ReferenceCopyLocalPaths>
      <ReferenceCopyLocalPaths Condition="'%(Extension)' == '.dll' and Exists('$(_WasmTrimmedClosureDir)%(FileName).dll')">
        <_WasmInTrimmedClosure>true</_WasmInTrimmedClosure>
      </ReferenceCopyLocalPaths>
      <!-- Drop assemblies the linker trimmed out of the app closure. -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Extension)' == '.dll' and '%(_WasmInTrimmedClosure)' != 'true'" />
      <!-- Repoint the kept closure assemblies at their trimmed IL so IL-only members share the trimmed MVIDs
           the per-app R2R members were compiled against (the R2R members are still staged from obj/R2R). -->
      <_WasmTrimmedClosureRedirect Include="@(ReferenceCopyLocalPaths)" Condition="'%(_WasmInTrimmedClosure)' == 'true'" />
      <ReferenceCopyLocalPaths Remove="@(_WasmTrimmedClosureRedirect)" />
      <ReferenceCopyLocalPaths Include="@(_WasmTrimmedClosureRedirect->'$(_WasmTrimmedClosureDir)%(FileName).dll')"
                               RelativePath="%(FileName)%(Extension)" />
      <!-- The project's own assembly does not travel through ReferenceCopyLocalPaths: _ComputeWasmBuildCandidates
           serves it from @(IntermediateAssembly), i.e. the UNTRIMMED compile output. Shipping that against the
           trimmed framework mismatches the two (e.g. the JSExport-generated call to RuntimeInformation.OSArchitecture
           survives in the untrimmed assembly while ILLink dropped the property from the trimmed CoreLib, giving a
           MissingMethodException at run time). @(WasmAssembliesFinal) is the SDK's designed override for exactly
           this: an entry whose file name matches IntermediateAssembly becomes the served project assembly. Skip it
           when a nested publish already supplied that set, or ComputeWasmBuildAssets sees two project assemblies. -->
      <WasmAssembliesFinal Include="@(IntermediateAssembly->'$(_WasmTrimmedClosureDir)%(FileName).dll')"
                           Condition="'$(_WasmCoreClrHasFinalAssemblies)' != 'true' and Exists('$(_WasmTrimmedClosureDir)%(IntermediateAssembly.FileName).dll')" />
    </ItemGroup>
  </Target>

  <!-- Same prune for publish, before ProcessPublishFilesForWasm derives _WasmResolvedFilesToPublish. -->
  <Target Name="_WasmCoreClrPruneR2RFromPublish"
          Condition="'$(_WasmEnableWebcil)' == 'true'"
          DependsOnTargets="_WasmCoreClrSelectR2RDirectories"
          BeforeTargets="ProcessPublishFilesForWasm">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.wasm' and '$(_WasmRuntimePackR2RDir)' != '' and Exists('$(_WasmRuntimePackR2RDir)%(FileName).wasm')" />
    </ItemGroup>
  </Target>

  <!-- Route per-app R2R images into the served _framework. The SDK CrossGen pipeline (ContainerFormat=wasm)
       replaces each IL .dll in ResolvedFileToPublish with its R2R image named <name>.wasm; ComputeWasmPublishAssets
       keys on the .dll extension to route managed assemblies into _framework, so a .wasm-named R2R image is treated
       as native and leaks to the publish root (leaving the boot config with no coreAssembly). _ReadyToRunCompileList
       maps each R2R output (OutputR2RImage) back to the IL .dll crossgen compiled (its Identity), so restore that IL
       .dll: ComputeWasmPublishAssets then classifies it as a managed assembly and ConvertDllsToWebcil stages the R2R
       image from PrebuiltR2RDirectory (= _WasmPublishR2RDir) keyed on that .dll, the same mechanism the dev-loop
       build uses for pack R2R. Using the compile list (not a link dir) covers both trimmed (IL from the linker) and
       untrimmed (IL from the pack) uniformly. DependsOnTargets=CreateReadyToRunImages so it runs after that target's
       .dll -> .wasm replacement.
       Two BeforeTargets, because two different targets consume the list depending on the flow:
       ProcessPublishFilesForWasm for a plain publish, and _GatherWasmFilesToPublish when a native relink is in
       play. The relink runs the trimming and crossgen inside WasmNestedPublishApp, where
       ProcessPublishFilesForWasm is skipped ('$(WasmBuildingForNestedPublish)' != 'true'); there
       _GatherWasmFilesToPublish derives WasmAssembliesToBundle -> WasmAssembliesFinal from
       ResolvedFileToPublish, keeping only .dll, and ProcessPublishFilesForWasm in the OUTER pass then publishes
       from WasmAssembliesFinal instead of ResolvedFileToPublish. Without routing in the nested pass every
       crossgen'd assembly is still named .wasm at that point and silently drops out of the bundle - observed as
       a publish that exits 0 with only the uncompiled facades staged and no System.Private.CoreLib.
       See dotnet/runtime#121257. -->
  <Target Name="_WasmCoreClrRoutePerAppR2RToFramework"
          Condition="'$(_WasmEnableWebcil)' == 'true' and '$(PublishReadyToRun)' == 'true'"
          DependsOnTargets="_WasmCoreClrSelectR2RDirectories;CreateReadyToRunImages"
          BeforeTargets="ProcessPublishFilesForWasm;_GatherWasmFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_ReadyToRunCompileList->'%(OutputR2RImage)')" />
      <ResolvedFileToPublish Include="@(_ReadyToRunCompileList)"
                             RelativePath="%(FileName)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Feed the trimmed IL closure into mainline R2R as the compile+reference set (see dotnet/runtime#121257).
       On the Blazor/SWA route ILLink stamps PostprocessAssembly=true on its own collection, not on
       ResolvedFileToPublish, so the mainline compile list is empty and crossgen2 never runs. -->
  <Target Name="_WasmFeedReadyToRunCompileList"
          Condition="'$(PublishReadyToRun)' == 'true' and '$(PublishTrimmed)' == 'true' and '$(PublishReadyToRunComposite)' != 'true' and '$(IntermediateLinkDir)' != ''"
          BeforeTargets="_PrepareForReadyToRunCompilation">
    <ItemGroup>
      <!-- Clear the stale base-SDK R2R mark on the untrimmed runtime-pack copy (e.g. CoreLib under native/)
           so crossgen resolves against the trimmed IL supplied below; it stays for webcil output. -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" PostprocessAssembly="false"
        Condition="'%(ResolvedFileToPublish.PostprocessAssembly)' == 'true' and Exists('$(IntermediateLinkDir)%(ResolvedFileToPublish.FileName).dll')" />
    </ItemGroup>
    <ItemGroup>
      <!-- The linker output is exactly ManagedAssemblyToLink minus what trimming removed, so map that
           item into IntermediateLinkDir (mirrors ILLink's own _LinkedResolvedFileToPublishCandidate)
           rather than globbing every *.dll in the dir. -->
      <_WasmReadyToRunCompileInput Include="@(ManagedAssemblyToLink->'$(IntermediateLinkDir)%(FileName)%(Extension)')"
                                   Condition="Exists('$(IntermediateLinkDir)%(FileName)%(Extension)')" />
      <ResolvedFileToPublish Include="@(_WasmReadyToRunCompileInput)"
                             PostprocessAssembly="true"
                             RelativePath="%(FileName)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Force crossgen (CreateReadyToRunImages) before ProcessPublishFilesForWasm: the latter runs
       AfterTargets=ILLink, which a Blazor publish schedules ahead of R2R, so the images would ship too late. -->
  <Target Name="_WasmEnsureReadyToRunBeforePublish"
          Condition="'$(PublishReadyToRun)' == 'true' and '$(PublishReadyToRunComposite)' != 'true' and '$(WasmBuildingForNestedPublish)' != 'true'"
          DependsOnTargets="CreateReadyToRunImages"
          BeforeTargets="ProcessPublishFilesForWasm" />

  <!-- Per-app crossgen must be conservative: a single assembly (or the crossgen2/JIT) change has to recompile
       EVERY per-app R2R image, because cross-module inlining (opt-cross-module) lets any image inline from any
       other and a stale image fail-fasts at startup (the runtime R2R MVID check). _CreateR2RImages batches its
       Outputs per assembly (%(_ReadyToRunCompileList.OutputR2RImage)) which alone would rebuild only the changed
       image; adding the whole compile+reference closure and the wasm JIT as non-correlated _ReadyToRunCompilerInputs
       makes the whole target re-run on any change. Mirrors the framework build's sfxproj _ReadyToRunCompilerInputs
       (dotnet/runtime#121257). Runs after _PrepareForReadyToRunCompilation (populates the lists) and before
       _CreateR2RImages evaluates its Inputs. -->
  <Target Name="_WasmCoreClrConservativeR2RInputs"
          Condition="'$(PublishReadyToRun)' == 'true' and '$(PublishReadyToRunComposite)' != 'true'"
          BeforeTargets="_CreateR2RImages">
    <ItemGroup>
      <_ReadyToRunCompilerInputs Include="@(_ReadyToRunCompileList);@(_ReadyToRunAssembliesToReference)" />
      <_ReadyToRunCompilerInputs Include="$(_WasmResolvedCrossgen2Dir)clrjit_universal_wasm_*"
                                 Condition="'$(_WasmResolvedCrossgen2Dir)' != ''" />
    </ItemGroup>
  </Target>

  <!-- Delete per-app R2R images left in obj/R2R by a previous incremental build whose assembly is no longer in
       the compile closure (a reference or trimming change dropped it). A stale orphan would otherwise be staged
       and fail-fast at load against the current version bubble. Mirrors the framework build's sfxproj
       _WasmFrameworkR2RLayoutObsolete. Runs where crossgen produced the images (_ReadyToRunCompileList in scope). -->
  <Target Name="_WasmCoreClrPruneStalePerAppR2R"
          Condition="'$(PublishReadyToRun)' == 'true' and '$(PublishReadyToRunComposite)' != 'true'"
          DependsOnTargets="_WasmCoreClrSelectR2RDirectories"
          AfterTargets="_CreateR2RImages">
    <ItemGroup Condition="'$(_WasmPublishR2RDir)' != '' and Exists('$(_WasmPublishR2RDir)')">
      <_WasmStalePerAppR2R Include="$(_WasmPublishR2RDir)*.wasm"
                           Exclude="@(_ReadyToRunCompileList->'%(OutputR2RImage)')" />
    </ItemGroup>
    <Delete Files="@(_WasmStalePerAppR2R)" />
  </Target>

</Project>
