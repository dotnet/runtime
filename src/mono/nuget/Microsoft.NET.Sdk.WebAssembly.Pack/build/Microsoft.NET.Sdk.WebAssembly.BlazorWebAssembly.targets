***********************************************************************************************
-->
<Project>
  <PropertyGroup>
    <_WasmCoreClrEnableDiagnosticsSpecified Condition="'$(EnableDiagnostics)' != ''">true</_WasmCoreClrEnableDiagnosticsSpecified>
    <_WasmCoreClrEventSourceSupportSpecified Condition="'$(EventSourceSupport)' != ''">true</_WasmCoreClrEventSourceSupportSpecified>
  </PropertyGroup>

  <Import Project="$(MSBuildSDKsPath)/Microsoft.NET.Sdk.BlazorWebAssembly/targets/Microsoft.NET.Sdk.BlazorWebAssembly.Current.targets" />
</Project>
