<Project>
  <!-- Property overrides -->
  <PropertyGroup>
    <_TasksDir Condition="'$(MSBuildRuntimeType)' == 'Core'">$(MSBuildThisFileDirectory)..\tasks\net\</_TasksDir>
    <_TasksDir Condition="'$(MSBuildRuntimeType)' != 'Core'">$(MSBuildThisFileDirectory)..\tasks\netframework\</_TasksDir>

    <WasmAppBuilderTasksAssemblyPath>$(_TasksDir)WasmAppBuilder.dll</WasmAppBuilderTasksAssemblyPath>
    <WasmBuildTasksAssemblyPath>$(_TasksDir)WasmBuildTasks.dll</WasmBuildTasksAssemblyPath>
    <WasmAppHostDir>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory), '..', 'WasmAppHost'))</WasmAppHostDir>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)\WasiApp.props" />
  <!-- CoreCLR targets import the shared WasiApp.targets and override its host linking.
       NativeAOT produces its own native executable and must not run those managed-app bundling hooks. -->
  <Import Project="$(MSBuildThisFileDirectory)\WasiApp.CoreCLR.targets" Condition="'$(PublishAot)' != 'true'" />
</Project>
