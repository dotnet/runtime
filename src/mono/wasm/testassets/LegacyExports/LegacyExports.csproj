<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LegacyTargetFramework Condition="'$(LegacyTargetFramework)' == ''">net10.0</LegacyTargetFramework>
    <LegacyTargetingPackVersion Condition="'$(LegacyTargetingPackVersion)' == ''">10.0.0</LegacyTargetingPackVersion>
    <TargetFramework>$(LegacyTargetFramework)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the legacy generator even when the SDK's default targeting pack advances. -->
    <KnownFrameworkReference Update="Microsoft.NETCore.App">
      <TargetingPackVersion Condition="'%(KnownFrameworkReference.TargetFramework)' == '$(LegacyTargetFramework)'">$(LegacyTargetingPackVersion)</TargetingPackVersion>
    </KnownFrameworkReference>
  </ItemGroup>
</Project>
