<Project>
  <!-- This depends on the root Directory.Build.props imported this file -->
  <Import Project="$(MSBuildThisFileDirectory)WasiApp.props" />

  <!-- Mirror of src/mono/browser/build/WasmApp.InTree.props: CoreCLR-WASI links the
       wasihost corehost, per-app, to cover app/test reverse thunks (see
       WasiApp.CoreCLR.targets). -->
  <PropertyGroup>
    <UseMonoRuntime>false</UseMonoRuntime>
    <WasiCoreCLRHostNativeDir>$([MSBuild]::NormalizeDirectory('$(ArtifactsBinDir)', 'wasi-wasm.$(Configuration)', 'sharedFramework'))</WasiCoreCLRHostNativeDir>
    <WasiCoreCLRNativeRuntimeDir>$([MSBuild]::NormalizeDirectory('$(ArtifactsBinDir)', 'coreclr', 'wasi.wasm.$(Configuration)', 'sharedFramework'))</WasiCoreCLRNativeRuntimeDir>
    <!-- Full ICU globalization: the wasihost corehost preloads icudt.dat (see
         src/native/corehost/wasihost / WasiApp.CoreCLR.targets), so the leg no longer needs
         invariant mode. -->
    <InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">false</InvariantGlobalization>
    <!-- Import the in-build crossgen2 targets after the SDK, then override compiler resolution
         with the direct in-build layout. -->
    <AfterMicrosoftNETSdkTargets Condition="'$(Crossgen2SdkOverrideTargetsPath)' != '' and Exists('$(Crossgen2SdkOverrideTargetsPath)')">$(AfterMicrosoftNETSdkTargets);$(Crossgen2SdkOverrideTargetsPath)</AfterMicrosoftNETSdkTargets>
    <AfterMicrosoftNETSdkTargets Condition="Exists('$(MSBuildThisFileDirectory)WasiApp.ReadyToRun.targets')">$(AfterMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)WasiApp.ReadyToRun.targets</AfterMicrosoftNETSdkTargets>
  </PropertyGroup>
  <Import Project="$(Crossgen2SdkOverridePropsPath)"
          Condition="'$(RuntimeFlavor)' == 'CoreCLR' and '$(Crossgen2SdkOverridePropsPath)' != '' and Exists('$(Crossgen2SdkOverridePropsPath)')" />

  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <EnableTargetingPackDownload>false</EnableTargetingPackDownload>
    <TargetFramework>$(NetCoreAppCurrent)</TargetFramework>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

</Project>
