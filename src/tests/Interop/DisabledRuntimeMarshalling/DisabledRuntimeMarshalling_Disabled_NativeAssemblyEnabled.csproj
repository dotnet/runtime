<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- No test-specific corerun on wasm: the generator or the wasm linker rejects this test's
         native interop surface. Native-dependent tests skip instead. Tracked by https://github.com/dotnet/runtime/issues/131811 -->
    <WasmBuildTestCorerun Condition="'$(RuntimeFlavor)' == 'coreclr' and '$(TargetOS)' == 'browser'">false</WasmBuildTestCorerun>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <MonoAotIncompatible>true</MonoAotIncompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PInvokeAssemblyMarshallingEnabled/*.cs" />
    <Compile Include="AutoLayout.cs" />
    <Compile Include="FunctionPointers.cs" />
    <Compile Include="RuntimeMarshallingDisabledAttribute.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Native_Default/DisabledRuntimeMarshallingNative_Default.csproj" />
    <CMakeProjectReference Include="CMakeLists.txt" />
  </ItemGroup>
</Project>
