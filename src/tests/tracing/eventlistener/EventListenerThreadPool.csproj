<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for CLRTestTargetUnsupported -->
    <RequiresProcessIsolation Condition="'$(RuntimeFlavor)' == 'coreclr' and '$(TargetOS)' == 'browser'">true</RequiresProcessIsolation>
    <!-- TODO: Re-enable when browser CoreCLR supports ThreadPool registered waits.
         Tracked by https://github.com/dotnet/runtime/issues/131321. -->
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' == 'coreclr' and '$(TargetOS)' == 'browser'">true</CLRTestTargetUnsupported>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableProjectBuild Condition="'$(RuntimeFlavor)' == 'mono'">true</DisableProjectBuild>
    <!--  We expect to see events from the portable threadpool, AOT defaults to Windows threadpool -->
    <UseWindowsThreadPool Condition="'$(TestBuildMode)' == 'nativeaot'">false</UseWindowsThreadPool>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EventListenerThreadPool.cs" />
    <ProjectReference Include="../common/tracing_common.csproj" />
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
</Project>
