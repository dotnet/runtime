<Project>
  <!-- Native component tests use the root test build configuration instead of the managed tracing test configuration. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\Directory.Build.props" />
  <PropertyGroup>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <CLRTestTargetUnsupported Condition="'$(TargetsMobile)' == 'true' or '$(TargetsWasm)' == 'true'">true</CLRTestTargetUnsupported>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)common\NativeTestProcess.cs" />
  </ItemGroup>
</Project>
