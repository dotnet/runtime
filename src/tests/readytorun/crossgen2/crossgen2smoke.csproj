<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- ilasm round-trip testing doesn't make sense for this test -->
    <IlasmRoundTripIncompatible>true</IlasmRoundTripIncompatible>

    <!-- This is an explicit crossgen test -->
    <AlwaysUseCrossGen2>true</AlwaysUseCrossGen2>
    <CrossGen2TestExtraArguments>$(CrossGen2TestExtraArguments) --generate-unboxing-stubs</CrossGen2TestExtraArguments>
    <CrossGen2TestCheckPdb>true</CrossGen2TestCheckPdb>
    <!-- TODO: Re-enable when WASM R2R generic ldtoken calls no longer fail with a function-signature mismatch.
         Tracked by https://github.com/dotnet/runtime/issues/131321. -->
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' == 'coreclr' and '$(TargetOS)' == 'browser'">true</CLRTestTargetUnsupported>
  </PropertyGroup>

  <ItemGroup>
    <CheckPdbSymbol Include="System.Int32 Program+SomeClass::GetHashCode()" />
    <CheckPdbSymbol Include="System.String Program::ObjectToStringOnGenericParamTestWorker(System.__Canon&amp;)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>

  <Import Project="smoketest.targets" />
</Project>
