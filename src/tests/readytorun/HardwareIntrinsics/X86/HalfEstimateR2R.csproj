<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <CLRTestTargetUnsupported Condition="'$(TargetArchitecture)' != 'x64' OR '$(RuntimeFlavor)' != 'coreclr'">true</CLRTestTargetUnsupported>
    <AlwaysUseCrossGen2>true</AlwaysUseCrossGen2>
    <CrossGen2TestExtraArguments>$(CrossGen2TestExtraArguments) --instruction-set:avx2</CrossGen2TestExtraArguments>
    <IlasmRoundTripIncompatible>true</IlasmRoundTripIncompatible>
    <NativeAotIncompatible>true</NativeAotIncompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="HalfEstimateR2R.cs" />
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
</Project>
