<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <AlwaysUseCrossGen2>true</AlwaysUseCrossGen2>
    <Optimize>true</Optimize>
    <!-- Instruction GC stress requires a debug or checked runtime and patchable image code. -->
    <CLRTestTargetUnsupported Condition="'$(Configuration)' == 'Release' or '$(TargetArchitecture)' == 'wasm' or '$(TargetsOSX)' == 'true' or '$(TargetsAppleMobile)' == 'true'">true</CLRTestTargetUnsupported>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GCStress.cs" />
    <CLRTestEnvironmentVariable Include="DOTNET_GCStress" Value="8" />
    <CLRTestEnvironmentVariable Include="DOTNET_GcCoverage" Value="/R2RGCStress/" />
    <CLRTestEnvironmentVariable Include="DOTNET_gcConcurrent" Value="0" />
    <CLRTestEnvironmentVariable Include="DOTNET_ReadyToRun" Value="1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
</Project>
