<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for IlasmRoundTripIncompatible -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AlwaysUseCrossGen2>true</AlwaysUseCrossGen2>
    <IlasmRoundTripIncompatible>true</IlasmRoundTripIncompatible>
    <!-- TODO: Re-enable when Crossgen2 and browser CoreCLR agree on Int128 aggregate alignment.
         Tracked by https://github.com/dotnet/runtime/pull/131421. -->
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' == 'coreclr' and '$(TargetOS)' == 'browser'">true</CLRTestTargetUnsupported>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="fieldlayouttests.cs" />
    <Compile Include="../../../coreclr/tools/aot/ILCompiler.TypeSystem.Tests/CoreTestAssembly/InstanceFieldLayout.cs" />
  </ItemGroup>
</Project>
