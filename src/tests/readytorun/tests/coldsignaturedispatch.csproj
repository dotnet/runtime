<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- Keep this conditional so the priority-0 text filter includes the Windows x86 regression. -->
    <CLRTestPriority Condition="'$(TargetOS)' != 'windows' or '$(TargetArchitecture)' != 'x86'">1</CLRTestPriority>
    <AlwaysUseCrossGen2 Condition="'$(TargetOS)' == 'windows' and '$(TargetArchitecture)' == 'x86'">true</AlwaysUseCrossGen2>
    <Optimize>true</Optimize>
    <!-- Exercises native virtual-dispatch stubs under GC stress. -->
    <CLRTestTargetUnsupported Condition="'$(TargetArchitecture)' == 'wasm'">true</CLRTestTargetUnsupported>
    <!-- Layout verification would load the signature-only struct before dispatch. -->
    <CrossGen2TestExtraArguments>--verify-type-and-field-layout:false</CrossGen2TestExtraArguments>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="coldsignaturedispatch.cs" />
    <ProjectReference Include="signaturedependency.csproj" />
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
</Project>
