<Project Sdk="Microsoft.NET.Sdk.IL">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <CLRTestKind>SharedLibrary</CLRTestKind>
    <IlasmFlags>$(IlasmFlags) -PE64 -ARM64</IlasmFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Arm64.il" />
    <Compile Include="ExecutableData.il" />
  </ItemGroup>
</Project>
