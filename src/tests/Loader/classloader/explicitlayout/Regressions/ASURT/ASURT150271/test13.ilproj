<Project Sdk="Microsoft.NET.Sdk.IL">
  <PropertyGroup>
    <MonoAotIncompatible>true</MonoAotIncompatible>  <!-- https://github.com/dotnet/runtime/issues/90427  -->
    <!-- Needed for MonoAotIncompatible -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- The test has its own Main, so the WASI ReadyToRun failure is skipped here.
         ActiveIssue https://github.com/dotnet/runtime/issues/134949 -->
    <R2RIncompatible Condition="'$(TargetOS)' == 'wasi'">true</R2RIncompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="test13.il" />
  </ItemGroup>
</Project>
