<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IlasmRoundTripIncompatible>true</IlasmRoundTripIncompatible>
    <!-- TODO: Re-enable when browser CoreCLR can execute this AssemblyLoadContext resolution flow
         without a WebAssembly function-signature mismatch.
         Tracked by https://github.com/dotnet/runtime/issues/131321. -->
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' == 'coreclr' and '$(TargetOS)' == 'browser'">true</CLRTestTargetUnsupported>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BinderTracingTest.EventHandlers.cs" />
    <Compile Include="BinderTracingTest.ResolutionFlow.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
  <Import Project="BinderTracingTest.targets" />
</Project>
