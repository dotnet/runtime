<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>X86_Avx512F_r</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Managed ilasm exhausts the 32-bit address space while assembling this test. -->
    <ManagedIlasmRoundTripIncompatible Condition="'$(TargetArchitecture)' == 'x86'">true</ManagedIlasmRoundTripIncompatible>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>Embedded</DebugType>
    <Optimize />
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.Avx512F.cs" />
    <Compile Include="..\..\X86\Shared\Program.cs" />
  </ItemGroup>
</Project>
