<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>X86_Avx512F_ro</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Test assets are architecture-neutral, so this x86 managed-ilasm OOM exclusion must be unconditional. -->
    <ManagedIlasmRoundTripIncompatible>true</ManagedIlasmRoundTripIncompatible>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>Embedded</DebugType>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.Avx512F.cs" />
    <Compile Include="..\..\X86\Shared\Program.cs" />
  </ItemGroup>
</Project>
