<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for CLRTestEnvironmentVariable -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>PdbOnly</DebugType>
    <Optimize>True</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).cs" />

    <!-- Guarded loads are only if-converted on x64 with APX. Without APX hardware the
         JIT does not use APX encodings and the test still passes. -->
    <CLRTestEnvironmentVariable Include="DOTNET_TieredCompilation" Value="0" />
    <CLRTestEnvironmentVariable Include="DOTNET_EnableAPX" Value="1" />
    <CLRTestEnvironmentVariable Include="DOTNET_EnableApxNDD" Value="1" />
    <CLRTestEnvironmentVariable Include="DOTNET_EnableApxConditionalChaining" Value="1" />
    <CLRTestEnvironmentVariable Include="DOTNET_EnableApxZU" Value="0" />
    <CLRTestEnvironmentVariable Include="DOTNET_EnableApxPPHint" Value="1" />
    <CLRTestEnvironmentVariable Include="DOTNET_EnableApxPP2" Value="1" />
    <CLRTestEnvironmentVariable Include="DOTNET_EnableApxCfcmov" Value="1" />
  </ItemGroup>
</Project>
