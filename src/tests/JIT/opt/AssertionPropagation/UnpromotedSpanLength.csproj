<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DebugType>PdbOnly</DebugType>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).cs" />
    <!-- Exercise field loads even on ABIs that normally promote the span. -->
    <CLRTestEnvironmentVariable Include="DOTNET_JitNoStructPromotion" Value="1" />
    <CLRTestEnvironmentVariable Include="DOTNET_JitEnablePhysicalPromotion" Value="0" />
  </ItemGroup>
</Project>
