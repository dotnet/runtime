<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for CLRTestEnvironmentVariable -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <Optimize>True</Optimize>
    <CLRTestPriority>1</CLRTestPriority>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).cs" />
    <Compile Include="VnniRegisterPressure.cs" />

    <!-- Also disables AVX10v1, AVX10v2 and AVXVNNIINT_V512, which imply AVX512v3. -->
    <CLRTestEnvironmentVariable Include="DOTNET_EnableAVX512v3" Value="0" />
  </ItemGroup>
</Project>
