<Project Sdk="Microsoft.NET.Sdk.IL">
  <PropertyGroup>
    <!-- Before the fix, compiling any of the invalid methods crashes the process. -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- The NativeAOT scanner cannot import the invalid fall-through methods. -->
    <NativeAotIncompatible>true</NativeAotIncompatible>
    <!-- Mono full AOT cannot compile the invalid methods or JIT them at runtime. -->
    <MonoAotIncompatible>true</MonoAotIncompatible>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>None</DebugType>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).il" />
  </ItemGroup>
</Project>
