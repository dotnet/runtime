<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Optimize>True</Optimize>
    <!-- Force crossgen on the browser leg so this actually runs as wasm R2R. -->
    <AlwaysUseCrossGen2 Condition="'$(TargetOS)' == 'browser'">true</AlwaysUseCrossGen2>
    <!-- Without this, the test defaults to CLRTestKind=SharedLibrary and is never actually
         executed (build-only), silently passing without exercising the fix. -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).cs" />
  </ItemGroup>
</Project>
