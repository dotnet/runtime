<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CLRTestPriority>1</CLRTestPriority>
    <Optimize>True</Optimize>
    <DebugType>None</DebugType>
    <!-- Needed for CLRTestEnvironmentVariable -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- GC stress allocates synthetic objects on the current thread, invalidating the zero-allocation assertion. -->
    <GCStressIncompatible>true</GCStressIncompatible>
    <!-- Tiered compilation is disabled in interpreter mode. -->
    <InterpreterIncompatible>true</InterpreterIncompatible>
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' == 'coreclr' and '$(TargetOS)' == 'browser'">true</CLRTestTargetUnsupported>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).cs" />
    <ProjectReference Include="$(TestLibraryProjectPath)" />

    <CLRTestEnvironmentVariable Include="DOTNET_TC_CallCountThreshold" Value="1" />
    <CLRTestEnvironmentVariable Include="DOTNET_TC_CallCountingDelayMs" Value="0" />
    <CLRTestEnvironmentVariable Include="DOTNET_TieredCompilation" Value="1" />
    <CLRTestEnvironmentVariable Include="DOTNET_TieredPGO" Value="1" />
    <!-- Also instrument optimized code. This is only available in the Checked and Debug JIT. -->
    <CLRTestEnvironmentVariable Include="DOTNET_JitInstrumentIfOptimizing" Value="1" />
    <CLRTestEnvironmentVariable Include="DOTNET_JITMinOpts" Value="0" />
  </ItemGroup>
</Project>
