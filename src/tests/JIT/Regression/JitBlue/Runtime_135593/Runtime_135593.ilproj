<Project Sdk="Microsoft.NET.Sdk.IL">
  <PropertyGroup>
    <CLRTestPriority>1</CLRTestPriority>
    <MonoAotIncompatible>true</MonoAotIncompatible>  <!-- https://github.com/dotnet/runtime/issues/135639 -->
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>PdbOnly</DebugType>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).il" />
  </ItemGroup>
</Project>
