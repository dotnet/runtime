<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Optimize>True</Optimize>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- AVX10.2 is not expected on macOS, and instruction-level GCStress needs coredistools,
         which is not in Core_Root there, so the runtime would fail to start. -->
    <CLRTestTargetUnsupported Condition="'$(TargetOS)' != 'windows' and '$(TargetOS)' != 'linux'">true</CLRTestTargetUnsupported>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).cs" />

    <CLRTestEnvironmentVariable Include="DOTNET_TieredCompilation" Value="0" />
    <CLRTestEnvironmentVariable Include="DOTNET_EnableAVX10v2" Value="1" />
    <!-- Force a GC at every instruction so a stale gcref register is caught -->
    <CLRTestEnvironmentVariable Include="DOTNET_GCStress" Value="4" />
  </ItemGroup>
</Project>
