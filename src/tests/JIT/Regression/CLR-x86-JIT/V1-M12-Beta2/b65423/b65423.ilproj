<Project Sdk="Microsoft.NET.Sdk.IL">
  <PropertyGroup>
    <!-- Let the CoreCLR-browser merged runner apply the ActiveIssue before Environment.Exit. -->
    <RequiresProcessIsolation Condition="'$(RuntimeFlavor)' != 'coreclr' or '$(TargetOS)' != 'browser'">true</RequiresProcessIsolation>
    <CLRTestPriority>1</CLRTestPriority>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>PdbOnly</DebugType>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).il" />
  </ItemGroup>
</Project>
