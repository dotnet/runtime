<Project Sdk="Microsoft.NET.Sdk.IL">
  <PropertyGroup>
    <!-- The shared IL fixture deliberately repeats local names in the PDB. -->
    <IlasmFlags>$(IlasmFlags) -ERR</IlasmFlags>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>Full</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="throw1dimarray_d.il" />
    <Compile Include="throw1dimarray.il" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\common\eh_common.csproj" />
  </ItemGroup>
</Project>
