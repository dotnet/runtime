<Project Sdk="Microsoft.NET.Sdk.IL">
  <PropertyGroup>
    <MonoAotIncompatible>true</MonoAotIncompatible>  <!-- https://github.com/dotnet/runtime/issues/90427  -->
    <!-- Needed for NativeIldasmRoundTripIncompatible -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>PdbOnly</DebugType>
    <Optimize>True</Optimize>
    <!-- The native ildasm labels a branch target that is not an instruction start: https://github.com/dotnet/runtime/issues/38506 -->
    <NativeIldasmRoundTripIncompatible>true</NativeIldasmRoundTripIncompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ver_fg_13.il" />
  </ItemGroup>
</Project>
