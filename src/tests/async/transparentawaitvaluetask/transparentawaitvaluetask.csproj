<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <CLRTestKind>BuildAndRun</CLRTestKind>
    <CLRTestPriority>0</CLRTestPriority>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <ReferenceXUnitWrapperGenerator>false</ReferenceXUnitWrapperGenerator>
    <!--
      The regression only reproduces when the compiler-inserted
      AsyncHelpers.TransparentAwait call is not inlined, which is what
      OptimizationPreference=Size produces. Keep the setting on the project so the
      Native AOT test leg compiles this test with the size optimization switch
      instead of relying on a command line property that the test build does not forward.
    -->
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).cs" />
  </ItemGroup>
</Project>
