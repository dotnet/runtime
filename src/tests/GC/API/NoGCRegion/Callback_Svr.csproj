<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for CLRTestTargetUnsupported -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- Consider enable it for Mono whenever the implementation is ready -->
    <!-- https://github.com/dotnet/runtime/issues/73167 -->
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' != 'coreclr'">true</CLRTestTargetUnsupported>
    <!-- TODO: Re-enable when CoreCLR WebAssembly supports server GC and managed threads.
         Tracked by https://github.com/dotnet/runtime/issues/131321. -->
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' == 'coreclr' and '$(TargetOS)' == 'browser'">true</CLRTestTargetUnsupported>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <CLRTestBatchPreCommands><![CDATA[
      $(CLRTestBatchPreCommands)
      set DOTNET_gcServer=1
      set DOTNET_GCHeapCount=2
      ]]></CLRTestBatchPreCommands>
    <CLRTestBashPreCommands><![CDATA[
      $(CLRTestBashPreCommands)
      export DOTNET_gcServer=1
      export DOTNET_GCHeapCount=2
      ]]></CLRTestBashPreCommands>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Callback.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
</Project>
