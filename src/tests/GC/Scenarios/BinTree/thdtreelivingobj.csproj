<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for CLRTestTargetUnsupported, GCStressIncompatible, UnloadabilityIncompatible -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <CLRTestTargetUnsupported Condition="'$(FeatureMultithreading)' != 'true'">true</CLRTestTargetUnsupported>

    <!-- Test needs explicit Main as it uses command-line parameters -->
    <ReferenceXUnitWrapperGenerator>false</ReferenceXUnitWrapperGenerator>

    <GCStressIncompatible>true</GCStressIncompatible>
    <!-- The test leaves threads running at exit -->
    <UnloadabilityIncompatible>true</UnloadabilityIncompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="thdtreelivingobj.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="bintree.csproj" />
  </ItemGroup>
</Project>
