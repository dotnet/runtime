<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <CLRTestPriority>0</CLRTestPriority>
    <CLRTestTargetUnsupported Condition="('$(TargetOS)' != 'linux' and '$(TargetOS)' != 'osx') or ('$(TargetArchitecture)' != 'x64' and '$(TargetArchitecture)' != 'arm64') or '$(TestBuildMode)' != 'nativeaot'">true</CLRTestTargetUnsupported>
    <!-- Full dumps of sanitized processes can be prohibitively large. -->
    <CLRTestTargetUnsupported Condition="'$(EnableNativeSanitizers)' != ''">true</CLRTestTargetUnsupported>
    <!-- Linked createdump is Linux-only; macOS validates the external createdump shipped in the test payload. -->
    <CreatedumpSupport Condition="'$(TestBuildMode)' == 'nativeaot' and '$(TargetOS)' == 'linux'">true</CreatedumpSupport>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <ReferenceXUnitWrapperGenerator>false</ReferenceXUnitWrapperGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CreatedumpValidation.cs" />
  </ItemGroup>
  <Target Name="SignNativeExecutableForCreatedump" AfterTargets="NativeCompile" Condition="'$(TargetOS)' == 'osx'">
    <Exec Command="codesign -s - -f --entitlements &quot;$(RepositoryEngineeringDir)native/entitlements.plist&quot; &quot;$(NativeBinary)&quot;" />
  </Target>
</Project>
