<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <CLRTestPriority>0</CLRTestPriority>
    <!-- Validates that the wasi:http imports from System.Net.Http link into a valid component. -->
    <CLRTestTargetUnsupported Condition="'$(TargetsWasi)' != 'true'">true</CLRTestTargetUnsupported>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <ReferenceXUnitWrapperGenerator>false</ReferenceXUnitWrapperGenerator>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WasiHttp.cs" />
  </ItemGroup>
</Project>
