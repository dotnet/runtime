<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <CLRTestPriority>0</CLRTestPriority>
    <Nullable>enable</Nullable>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <StripSymbols>true</StripSymbols>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <ReferenceXUnitWrapperGenerator>false</ReferenceXUnitWrapperGenerator>
  </PropertyGroup>

  <!-- The size budget is calibrated for optimized Linux x64 single-module builds. -->
  <PropertyGroup Condition="'$(TestBuildMode)' == 'nativeaot' and '$(TargetOS)' == 'linux' and '$(TargetArchitecture)' == 'x64' and '$(Configuration)' == 'Release' and '$(CoreCLRConfiguration)' == 'Release' and '$(OptimizationPreference)' == 'Size' and '$(IlcMultiModule)' != 'true' and '$(EnableNativeSanitizers)' == ''">
    <DefineConstants>$(DefineConstants);CHECK_SIZE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="$(RepoRoot)src/libraries/System.Text.Json/gen/System.Text.Json.SourceGeneration.Roslyn4.4.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>
</Project>
