<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <CLRTestPriority>0</CLRTestPriority>
    <!-- Linked-in createdump is only available in Linux NativeAOT tests. -->
    <CLRTestTargetUnsupported Condition="'$(TargetOS)' != 'linux' or '$(TestBuildMode)' != 'nativeaot'">true</CLRTestTargetUnsupported>
    <CreatedumpSupport Condition="'$(TestBuildMode)' == 'nativeaot'">true</CreatedumpSupport>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <ReferenceXUnitWrapperGenerator>false</ReferenceXUnitWrapperGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CreatedumpLinkedIn.cs" />
  </ItemGroup>
</Project>
