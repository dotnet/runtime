<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppToolCurrent)</TargetFramework>
    <Nullable>enable</Nullable>
    <IsShipping>false</IsShipping>
    <!-- Emit into stable, version-independent folder names instead of the TFM so consumers don't need
         updating whenever the .NET Core TFM bumps. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(OutputPath)net\</OutputPath>
    <IntermediateOutputPath>$(IntermediateOutputPath)net\</IntermediateOutputPath>
  </PropertyGroup>

</Project>
