<Project TreatAsLocalProperty="RuntimeFlavor;BuildNativeAOTRuntimePack;LibrariesRuntimeFlavor">
  <PropertyGroup>
    <RuntimeFlavor>CoreCLR</RuntimeFlavor>
    <BuildNativeAOTRuntimePack>true</BuildNativeAOTRuntimePack>
    <OutDirName>naot-pack</OutDirName>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="Sdk.props" Sdk="Microsoft.DotNet.SharedFramework.Sdk" />

  <PropertyGroup>
    <PlatformPackageType>RuntimePack</PlatformPackageType>
    <UseTemplatedPlatformManifest>true</UseTemplatedPlatformManifest>
    <UseRidGraph>true</UseRidGraph>
    <SkipInstallerBuild>true</SkipInstallerBuild>
    <PublishReadyToRun>false</PublishReadyToRun>
    <OverridePackageId>$(SharedFrameworkName).Runtime.NativeAOT.$(RuntimeIdentifier)</OverridePackageId>
    <IncludeStaticLibrariesInPack>true</IncludeStaticLibrariesInPack>
  </PropertyGroup>

  <PropertyGroup>
    <CoreLibConfiguration>$(CoreCLRConfiguration)</CoreLibConfiguration>
    <CoreLibProject>$([MSBuild]::NormalizePath('$(CoreClrProjectRoot)', 'nativeaot', 'System.Private.CoreLib', 'src', 'System.Private.CoreLib.csproj'))</CoreLibProject>
    <LibrariesRuntimeFlavor>CoreCLR</LibrariesRuntimeFlavor>
    <UseRuntimeManagedProjectReferences>true</UseRuntimeManagedProjectReferences>
    <UseMibcProjectReference>true</UseMibcProjectReference>
  </PropertyGroup>

  <ItemGroup>
    <IgnoredDuplicateType Include="Internal.Runtime.CompilerHelpers.LibraryInitializer" />
    <ProjectReference Include="$(CoreClrProjectRoot)nativeaot\System.Private.*\src\*.csproj"
                      AdditionalProperties="BuildAllProjects=true"
                      Exclude="$(CoreLibProject)"
                      GlobalPropertiesToRemove="LibrariesRuntimeFlavor;RuntimeFlavor;RuntimeIdentifier;TargetFramework"
                      OutputItemType="_NativeAotRuntimeAssembly"
                      ReferenceOutputAssembly="false"
                      SetConfiguration="Configuration=$(CoreCLRConfiguration)"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="AddNativeAOTManagedAssembliesToRuntimeFiles"
          BeforeTargets="AddRuntimeFilesToPackage"
          DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_NativeAotRuntimeManagedAssembly Include="@(_RuntimeCoreLibFile);@(_NativeAotRuntimeAssembly)" />
      <_NativeAotRuntimeAssemblySymbol Include="@(_NativeAotRuntimeManagedAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
      <_NativeAotRuntimeAssemblySymbol Remove="@(_NativeAotRuntimeAssemblySymbol)"
                                       Condition="!Exists('%(_NativeAotRuntimeAssemblySymbol.Identity)')" />
      <RuntimeFiles Include="@(_NativeAotRuntimeManagedAssembly);@(_NativeAotRuntimeAssemblySymbol)"
                    IsNative="true" />
    </ItemGroup>
  </Target>

  <Target Name="ResolveRuntimeMibcFile"
          DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <RuntimeMibcFile Include="@(MergedMibcFile)" />
    </ItemGroup>
  </Target>

  <Target Name="AddMibcFileToNativeAOTPackage"
          BeforeTargets="GetFilesToPackage"
          DependsOnTargets="ResolveRuntimeMibcFile">
    <ItemGroup>
      <FilesToPackage Include="@(RuntimeMibcFile)"
                      Condition="Exists('%(RuntimeMibcFile.Identity)')" />
    </ItemGroup>
  </Target>

  <Import Project="Microsoft.NETCore.App.Runtime.props" />

  <Target Name="IncludeSymbolFilesInNativeAOTPackage"
          AfterTargets="GetFilesToPackage">
    <ItemGroup>
      <!-- ILC needs the symbols next to the binaries -->
      <FilesToPackage Condition="'%(FilesToPackage.IsSymbolFile)' == 'true'">
        <IncludeAlways>true</IncludeAlways>
      </FilesToPackage>
      <FilesToPackage Condition="'%(Filename)%(Extension)' == 'nonportable.txt'">
        <ExcludeFromDataFiles>true</ExcludeFromDataFiles>
      </FilesToPackage>
    </ItemGroup>
  </Target>
</Project>
