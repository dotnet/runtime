<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ILCompiler.Reflection.ReadyToRun</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <AssemblyKey>Open</AssemblyKey>
    <IsDotNetFrameworkProductAssembly>true</IsDotNetFrameworkProductAssembly>
    <TargetFramework>$(NetCoreAppMinimum)</TargetFramework>
    <CLSCompliant>false</CLSCompliant>
    <NoWarn>$(NoWarn);8002;NU1701</NoWarn>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <OutputPath>$(RuntimeBinDir)</OutputPath>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RunAnalyzers>false</RunAnalyzers>
    <IsPackable>true</IsPackable>
    <IsShipping>false</IsShipping>
    <PackageDescription>This package provides a low-level ReadyToRun file format decoder. This package is experimental.</PackageDescription>
    <PackageId>ILCompiler.Reflection.ReadyToRun.Experimental</PackageId>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Include="..\..\Common\Internal\Runtime\CorConstants.cs" Link="Common\CorConstants.cs" />
    <Compile Include="..\..\Common\Internal\Runtime\ModuleHeaders.cs" Link="Common\ModuleHeaders.cs" />
    <Compile Include="..\..\Common\Internal\Runtime\ReadyToRunConstants.cs" Link="Common\ReadyToRunConstants.cs" />
    <Compile Include="..\..\Common\Internal\Runtime\ReadyToRunInstructionSet.cs" Link="Common\ReadyToRunInstructionSet.cs" />
    <Compile Include="..\..\Common\Compiler\ObjectWriter\Dwarf\DwarfHelper.cs" Link="Common\DwarfHelper.cs" />
    <Compile Include="..\..\Common\MachO\**\*.cs" Link="MachO\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Common\Pgo\PgoFormat.cs" Link="Common\PgoFormat.cs" />
    <Compile Include="..\..\Common\Wasm\Webcil.cs" Link="Webcil\Webcil.cs" />
  </ItemGroup>

  <!-- GC info decoders shared with the cDAC. See Cdac\CdacTarget.cs. -->
  <PropertyGroup>
    <CdacAbstractionsDir>$(RepoRoot)src\native\managed\cdac\Microsoft.Diagnostics.DataContractReader.Abstractions\</CdacAbstractionsDir>
    <CdacContractsDir>$(RepoRoot)src\native\managed\cdac\Microsoft.Diagnostics.DataContractReader.Contracts\</CdacContractsDir>
    <!-- The shared sources use nullable annotations; this project's public surface stays nullable-oblivious. -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CdacAbstractionsDir)TargetPointer.cs" Link="Cdac\Shared\TargetPointer.cs" />
    <Compile Include="$(CdacAbstractionsDir)FlushScope.cs" Link="Cdac\Shared\FlushScope.cs" />
    <Compile Include="$(CdacAbstractionsDir)Contracts\IContract.cs" Link="Cdac\Shared\IContract.cs" />
    <Compile Include="$(CdacAbstractionsDir)Contracts\IGCInfo.cs" Link="Cdac\Shared\IGCInfo.cs" />
    <Compile Include="$(CdacAbstractionsDir)Contracts\IRuntimeInfo.cs" Link="Cdac\Shared\IRuntimeInfo.cs" />
    <Compile Include="$(CdacContractsDir)Contracts\GCInfo\GCInfoDecoder.cs" Link="Cdac\Shared\GCInfo\GCInfoDecoder.cs" />
    <Compile Include="$(CdacContractsDir)Contracts\GCInfo\IGCInfoDecoder.cs" Link="Cdac\Shared\GCInfo\IGCInfoDecoder.cs" />
    <Compile Include="$(CdacContractsDir)Contracts\GCInfo\PlatformTraits\*.cs" Link="Cdac\Shared\GCInfo\PlatformTraits\%(Filename)%(Extension)" />
    <Compile Include="$(CdacContractsDir)Contracts\GCInfo\X86\*.cs" Link="Cdac\Shared\GCInfo\X86\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
