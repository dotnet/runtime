<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ILCompiler.Wasm</RootNamespace>
    <AssemblyName>ILCompiler.Wasm.Lowering</AssemblyName>
    <TargetFramework>$(NetCoreAppToolCurrent)</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseAppHost>false</UseAppHost>
    <Configurations>Debug;Release;Checked</Configurations>
    <IsShipping>false</IsShipping>
    <!-- Pinned so the SDK packs that ship this tool can glob its output without having to guess at
         a $(Platform) segment that varies with how the build was invoked. -->
    <OutputPath>$(WasmSignatureResolverDir)</OutputPath>
    <!-- The type system reads PDBs only for symbol-bearing diagnostics, which this tool never emits. -->
    <EnableDiaSymReaderUse>false</EnableDiaSymReaderUse>
    <NoWarn>$(NoWarn);CA1859</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ILCompiler.TypeSystem\ILCompiler.TypeSystem.csproj" />
  </ItemGroup>

  <!-- The lowering rules themselves are shared verbatim with crossgen2 and ILC. Linking the
       sources (rather than copying them) is what makes the "same answer as crossgen2" guarantee
       structural rather than a promise; WasmLoweringParityTests asserts it stays that way. -->
  <ItemGroup>
    <Compile Include="..\..\Common\JitInterface\WasmLowering.cs" Link="JitInterface\WasmLowering.cs" />
    <Compile Include="..\..\Common\Compiler\DependencyAnalysis\Target_Wasm\WasmTypes.cs" Link="Compiler\DependencyAnalysis\Target_Wasm\WasmTypes.cs" />
    <Compile Include="..\..\Common\Compiler\IWasmTypeCacheContext.cs" Link="Compiler\IWasmTypeCacheContext.cs" />
    <Compile Include="..\..\Common\TypeSystem\Interop\InteropTypes.cs" Link="TypeSystem\Interop\InteropTypes.cs" />
  </ItemGroup>

  <!-- Field layout algorithms. Struct sizes are only as correct as these are, so the set has to
       match what crossgen2 installs in ReadyToRunCompilerContext.GetLayoutAlgorithmForType. -->
  <ItemGroup>
    <Compile Include="..\..\Common\Compiler\VectorFieldLayoutAlgorithm.cs" Link="Compiler\VectorFieldLayoutAlgorithm.cs" />
    <Compile Include="..\..\Common\Compiler\Int128FieldLayoutAlgorithm.cs" Link="Compiler\Int128FieldLayoutAlgorithm.cs" />
    <Compile Include="..\..\Common\Compiler\DecimalFieldLayoutAlgorithm.cs" Link="Compiler\DecimalFieldLayoutAlgorithm.cs" />
    <Compile Include="..\ILCompiler.ReadyToRun\Compiler\VectorOfTFieldLayoutAlgorithm.cs" Link="Compiler\VectorOfTFieldLayoutAlgorithm.cs" />
  </ItemGroup>
</Project>
