<Project>

  <!--
    Set Platform=AnyCPU before importing Sdk.props.
    This test is meant to run on the build machine, so it should not be built for the target of the
    outer build / runtime target.
  -->
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <AssemblyName>ILCompiler.ReadyToRun.Tests</AssemblyName>
    <TargetFramework>$(NetCoreAppToolCurrent)</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TestRunnerAdditionalArguments>-notrait category=failing</TestRunnerAdditionalArguments>
    <!-- The tests always run on the build machine, so pin to the host RID and keep it out of the
         output path. Combined with Platform=AnyCPU above, every target-arch build shares one
         output directory. -->
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Each target stages its own assets into the shared output directory, but IncrementalClean
         deletes any file recorded in a previous build that the current build did not produce and
         that lives under OutDir. With a single file-write log the targets would evict each other's
         staged assets, so give each target its own log. Only the log has to be per-target; the rest
         of the intermediate directory stays shared, which keeps the runtimeconfig.json
         incrementality cache shared and therefore correctly invalidated when the target changes. -->
    <CleanFile>$(MSBuildProjectFile).$(TargetOS).$(TargetArchitecture).FileListAbsolute.txt</CleanFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisCSharpVersion)" />
    <PackageReference Include="Microsoft.DotNet.XUnitExtensions" Version="$(MicrosoftDotNetXUnitExtensionsVersion)" />
  </ItemGroup>

  <!-- Test case source files are embedded as resources so we can compile them with Roslyn at test time.
       Exclude subdirectory sources from compilation since they are compiled in-memory by R2RTestCaseCompiler. -->
  <ItemGroup>
    <Compile Remove="TestCases/*/**/*.cs" />
    <EmbeddedResource Include="TestCases/**/*.cs" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ILCompiler.Reflection.ReadyToRun/ILCompiler.Reflection.ReadyToRun.csproj" />
    <!-- Built for the outer TargetOS/TargetArchitecture, so it runs on the build machine but
         compiles for the target. Private="false" keeps it out of the output root; StageTargetAssets
         below places it under its own target-architecture subdirectory instead. -->
    <ProjectReference Include="../crossgen2/crossgen2_inbuild.csproj" ReferenceOutputAssembly="false" OutputItemType="Crossgen2InbuildOutputItems" Private="false">
      <SetConfiguration>Configuration=$(CoreCLRConfiguration);CopyAllJitLibrariesToAotCompilerOutput=true;TargetArchitecture=$(TargetArchitecture);TargetOS=$(TargetOS)</SetConfiguration>
    </ProjectReference>
  </ItemGroup>

  <PropertyGroup>
    <!-- Subdirectory of $(OutDir) that holds this root build's target-specific assets. Every build
         writes to a different one, so builds for different targets accumulate rather than clobber.
         Keyed on OS as well as architecture: several targets share an architecture (browser-wasm vs
         wasi-wasm, linux-x64 vs windows-x64) and must not overwrite each other's crossgen2 and
         libraries. Matches TestPaths.TargetAssetDirName. -->
    <TargetAssetDirName>$(TargetOS)-$(TargetArchitecture)</TargetAssetDirName>
  </PropertyGroup>

  <!-- Stage this root build's target-specific assets into $(OutDir)$(TargetAssetDirName)/. The
       directory name is derived from the target architecture, so successive root builds for
       different targets accumulate side by side (e.g. wasm/ and arm/) instead of clobbering
       each other.

       This must run before AssignTargetPaths: that target snapshots @(Content) into
       @(ContentWithTargetPath), which is what the stock copy-to-output-directory pipeline
       consumes. Hooking anything later (e.g. BeforeTargets="Build") is silently a no-op. -->
  <Target Name="StageTargetAssets"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'@(Crossgen2InbuildOutputItems)' == ''"
           Text="crossgen2_inbuild published no files. This is a build authoring error; the ProjectReference should have built it." />

    <!-- The shared framework references crossgen2 compiles against. These are taken from the
         already-built libs output rather than a ProjectReference: referencing sfx-src.proj walks
         all ~180 library projects on every build, which costs far more than it buys here since
         the 'libs' subset is a prerequisite of this project anyway. Both paths below are derived
         from the outer TargetOS/TargetArchitecture, so a root build for e.g. browser-wasm picks up
         the browser flavors. System.Private.CoreLib comes from CoreCLR's IL directory: the copy at
         the root of $(CoreCLRArtifactsPath) is the crossgen'd image, and crossgen2 needs IL. -->
    <Error Condition="!Exists('$(LibrariesSharedFrameworkBinArtifactsPath)')"
           Text="The 'libs' subset must be built for $(TargetOS)-$(TargetArchitecture) before building this project. Missing artifacts: $(LibrariesSharedFrameworkBinArtifactsPath). Configuration: '$(LibrariesConfiguration)'." />
    <Error Condition="!Exists('$(CoreCLRArtifactsPath)IL/System.Private.CoreLib.dll')"
           Text="The 'clr.corelib' subset must be built for $(TargetOS)-$(TargetArchitecture) before building this project. Missing artifacts: $(CoreCLRArtifactsPath)IL/System.Private.CoreLib.dll. Configuration: '$(CoreCLRConfiguration)'." />

    <ItemGroup>
      <_SharedFrameworkAssembly Include="$(LibrariesSharedFrameworkBinArtifactsPath)*.dll" />
      <_SharedFrameworkAssembly Include="$(CoreCLRArtifactsPath)IL/System.Private.CoreLib.dll" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="@(Crossgen2InbuildOutputItems)"
               CopyToOutputDirectory="PreserveNewest"
               TargetPath="$(TargetAssetDirName)/crossgen2/%(Filename)%(Extension)" />

      <Content Include="@(_SharedFrameworkAssembly)"
               CopyToOutputDirectory="PreserveNewest"
               TargetPath="$(TargetAssetDirName)/libraries/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <!-- These must be plain items rather than being set in a target: the incrementality hash for
       the runtimeconfig (_GenerateRuntimeConfigurationFilesInputCache) is computed from
       @(RuntimeHostConfigurationOption) before any BeforeTargets hook on
       GenerateBuildRuntimeConfigurationFiles gets to run. Values added from a target are therefore
       invisible to it, and since every target-architecture build shares one output directory, a
       stale runtimeconfig from a previous target would be silently reused. -->
  <ItemGroup>
    <!-- Used for gating Debug-only JIT features from being tested. -->
    <RuntimeHostConfigurationOption Include="R2RTest.CoreCLRConfiguration" Value="$(CoreCLRConfiguration)" />
    <!-- The target every test case compiles for. Distinct from $(RuntimeIdentifier) above, which is
         the RID the test assembly itself runs on. These are published as separate values rather than
         as a RID that the tests parse: $(TargetRid) can carry an OS qualifier or a distro name
         (linux-musl-x64, linux-bionic-arm64, alpine.3.19-x64), none of which crossgen2 accepts as a
         target OS. -->
    <RuntimeHostConfigurationOption Include="R2RTest.TargetOS" Value="$(TargetOS)" />
    <RuntimeHostConfigurationOption Include="R2RTest.TargetArchitecture" Value="$(TargetArchitecture)" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
