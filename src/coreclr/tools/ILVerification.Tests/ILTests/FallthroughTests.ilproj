<Project Sdk="Microsoft.NET.Sdk.IL">
  <PropertyGroup>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <!-- ilasm -OPTIMIZE would turn the long branches into short ones. -->
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildProjectName).il" />
  </ItemGroup>
</Project>
