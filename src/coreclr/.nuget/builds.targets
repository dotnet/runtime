<Project>
  <PropertyGroup Condition="'$(BuildIdentityPackage)' == ''">
    <BuildIdentityPackage>true</BuildIdentityPackage>

    <!-- During an official build, only build identity packages on windows x64 legs -->
    <BuildIdentityPackage Condition="'$(BuildingAnOfficialBuildLeg)' == 'true' AND ('$(OS)' != 'Windows_NT' OR '$(TargetArchitecture)' != 'x64')">false</BuildIdentityPackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsGraphBuild)' == 'true'">
    <AddTransitiveProjectReferencesInStaticGraph>false</AddTransitiveProjectReferencesInStaticGraph>
  </PropertyGroup>

  <ItemGroup>
    <_projectsToBuild Include="@(Project->WithMetadataValue('PackageTargetRuntime', '$(TargetRid)'))" />
    <_projectsToBuild Include="@(Project->WithMetadataValue('PackageTargetRuntime', ''))"
                      Condition="'$(BuildIdentityPackage)' == 'true'" />
    <_projectsToBuild Include="@(Project->WithMetadataValue('PackageTargetRuntime', '$(NETCoreSdkRuntimeIdentifier)'))"
                      Condition="'$(BuildHostILTools)' == 'true' and '$(IsILToolPackage)' == 'true'">
      <AdditionalProperties>%(AdditionalProperties);PackCrossComponent=true</AdditionalProperties>
    </_projectsToBuild>
    <ProjectReference Include="@(_projectsToBuild)" Targets="Build;Pack" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsGraphBuild)' == 'true'">
    <ProjectReferenceTargets Include="Pack" Targets="Build;Pack" />
  </ItemGroup>

  <Target Name="ValidatePackageTargetRid" BeforeTargets="Build;Pack">
    <Error Condition="'$(TargetRid)' == ''" Text="'TargetRid' property must be specified."/>
  </Target>
</Project>
