<Project>
  <PropertyGroup>
    <UsePkgProjTargets>false</UsePkgProjTargets>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.Build.NoTargets" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Microsoft.NETCore.ILAsm</PackageId>
    <Title>$(PackageId)</Title>
    <PackageDescription>The .NET IL Assembler.</PackageDescription>
    <PackageProjectUrl>https://dot.net/</PackageProjectUrl>
    <PackageIconUrl>http://go.microsoft.com/fwlink/?LinkID=288859</PackageIconUrl>
    <MinClientVersion>2.12</MinClientVersion>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeDesignerMarker>false</IncludeDesignerMarker>
    <EnableDefaultPackageReadmeFile>false</EnableDefaultPackageReadmeFile>
    <EnablePackageValidation>false</EnablePackageValidation>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <BeforePack>$(BeforePack);GenerateILAsmRuntimeDependencies</BeforePack>
  </PropertyGroup>

  <Import Project="..\package-rids.props" />

  <ItemGroup>
    <None Include="$(IntermediateOutputPath)runtime.json" Pack="true" PackagePath="/" />
  </ItemGroup>

  <UsingTask TaskName="GenerateILAsmRuntimeGraph"
             AssemblyFile="$(InstallerTasksAssemblyPath)"
             Runtime="NET"
             Architecture="*" />

  <Target Name="GenerateILAsmRuntimeDependencies">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <GenerateILAsmRuntimeGraph RuntimeIdentifiers="@(BuildRID)"
                              PackageId="$(PackageId)"
                              PackageVersion="$(PackageVersion)"
                              OutputPath="$(IntermediateOutputPath)runtime.json" />
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.Build.NoTargets" />
</Project>
