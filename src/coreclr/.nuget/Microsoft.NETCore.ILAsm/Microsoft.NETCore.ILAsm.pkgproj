<Project DefaultTargets="Build">
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Build.props))" />

  <PropertyGroup>
    <PackageDescription>The .NET IL Assembler.</PackageDescription>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PackageTargetRuntime)' == ''">
    <IsLineupPackage Condition="'$(IsLineupPackage)' == ''">true</IsLineupPackage>
    <PackageTargetRuntime Condition="'$(_packageTargetOSGroup)' == 'windows'">$(MinOSForArch)-$(PackagePlatform)</PackageTargetRuntime>
  </PropertyGroup>

  <PropertyGroup>
    <_ILAsmProject>ilasm</_ILAsmProject>
    <_ILAsmProject Condition="'$(PackCrossComponent)' == 'true'">ilasm_inbuild</_ILAsmProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsLineupPackage)' != 'true' and ('$(PackageTargetRuntime)' == '$(TargetRid)' or '$(PackCrossComponent)' == 'true')">
    <ProjectReference Include="$(ToolsProjectRoot)ilasm\src\ilasm\$(_ILAsmProject).csproj"
                      ReferenceOutputAssembly="false"
                      AdditionalProperties="ILAsmPackageRuntime=$(PackageTargetRuntime)" />
  </ItemGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Build.targets))" />
</Project>
