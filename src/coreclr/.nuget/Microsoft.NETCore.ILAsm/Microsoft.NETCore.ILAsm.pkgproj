<Project DefaultTargets="Build">
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Build.props))" />

  <PropertyGroup>
    <PackageDescription>The .NET IL Assembler.</PackageDescription>
    <IsLineupPackage>true</IsLineupPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Remove="@(ProjectReference)" />
    <_ILAsmRuntimeDependency Include="@(BuildRID)" TargetRuntime="%(Identity)" />
    <RuntimeDependency Include="@(_ILAsmRuntimeDependency->'runtime.%(Identity).Microsoft.NETCore.ILAsm')"
                       Version="$(PackageVersion)"
                       TargetPackage="Microsoft.NETCore.ILAsm" />
  </ItemGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Build.targets))" />
</Project>
