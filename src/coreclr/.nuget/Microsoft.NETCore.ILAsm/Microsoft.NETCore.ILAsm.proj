<Project Sdk="Microsoft.Build.Traversal">
  <PropertyGroup>
    <IsILToolPackage>true</IsILToolPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ToolsProjectRoot)ilasm\src\ilasm\ilasm.csproj" Build="false" Pack="false" />
    <ProjectReference Include="$(ToolsProjectRoot)ilasm\src\ilasm\ilasm_inbuild.csproj" Build="false" Pack="false" />
    <!-- identity project, runtime specific projects are included by props above -->
    <Project Include="$(MSBuildProjectName).pkgproj" />
  </ItemGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove(builds.targets))" />
</Project>
