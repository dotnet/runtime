<Project Sdk="Microsoft.Build.Traversal" DefaultTargets="Pack">
  <PropertyGroup>
    <UsePkgProjTargets>false</UsePkgProjTargets>
  </PropertyGroup>
  <ItemGroup>
    <Project Remove="@(Project)" />
    <ProjectReference Include="$(ToolsProjectRoot)ilasm\src\ilasm\ilasm.csproj" />
    <ProjectReference Include="$(ToolsProjectRoot)ilasm\src\ilasm\ilasm_inbuild.csproj" Build="false" Pack="false" />
    <!-- The lineup package is only built on the identity-package leg. -->
    <Project Include="$(MSBuildProjectName).pkgproj" />
  </ItemGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove(builds.targets))" />

  <Target Name="IncludeHostILAsmPackage" BeforeTargets="Build;Pack" Condition="'$(BuildHostILTools)' == 'true' and '$(TargetRid)' != '$(NETCoreSdkRuntimeIdentifier)'">
    <ItemGroup>
      <ProjectReference Update="$(ToolsProjectRoot)ilasm\src\ilasm\ilasm_inbuild.csproj" Build="true" Pack="true" />
    </ItemGroup>
  </Target>
</Project>
