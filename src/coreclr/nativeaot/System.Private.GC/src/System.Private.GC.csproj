<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <!-- The GC runs with the world suspended and must never allocate; nothing here may
         depend on the ref assembly surface of System.Private.CoreLib. -->
    <CompileUsingReferenceAssemblies>false</CompileUsingReferenceAssemblies>
    <!-- The port is not consumed by ILC yet, so keep it out of the aotsdk folder (which is
         shipped wholesale in the NativeAOT packs) while still building it in every build. -->
    <OutputPath>$(RuntimeBinDir)managedgc/</OutputPath>
    <DocumentationFile>$(OutputPath)$(MSBuildProjectName).xml</DocumentationFile>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The generated GCInterfaceOffsets.cs is only available when the native runtime is built
         alongside the managed one, which is the case for all in-tree builds. -->
    <InPlaceRuntime>true</InPlaceRuntime>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InPlaceRuntime)' == 'true'">
    <IntermediatesDir>$(ArtifactsObjDir)\coreclr\$(TargetOS).$(TargetArchitecture).$(CoreCLRConfiguration)</IntermediatesDir>
    <IntermediatesDir Condition="'$(Ninja)' == 'false' and $([MSBuild]::IsOsPlatform('Windows'))">$(IntermediatesDir)\ide</IntermediatesDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\System.Private.CoreLib\src\System.Private.CoreLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Internal\Runtime\GarbageCollection\GCEventEnums.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCEventStatus.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\IntroSort.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Interface\GCInterfaceEnums.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Interface\GCInterfaceLayout.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Interface\GCInterfaceStructs.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(InPlaceRuntime)' == 'true'">
    <Compile Include="$(IntermediatesDir)\nativeaot\Runtime\Full\GCInterfaceOffsets.cs" />
  </ItemGroup>
</Project>
