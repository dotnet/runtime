<Project>
  <Import Project="$(RepositoryEngineeringDir)testing\workloads-testing.targets" />

  <PropertyGroup>
    <_workItemTimeout Condition="'$(Scenario)' == 'BuildWasmApps' and '$(_workItemTimeout)' == ''">01:30:00</_workItemTimeout>
    <_workItemTimeout Condition="'$(NeedsToBuildWasmAppsOnHelix)' == 'true'">01:00:00</_workItemTimeout>

    <BrowserBuildTargetsDir>$([MSBuild]::NormalizeDirectory($(BrowserProjectRoot), 'build'))</BrowserBuildTargetsDir>
    <WasmBuildTargetsDir>$([MSBuild]::NormalizeDirectory($(WasmProjectRoot), 'build'))</WasmBuildTargetsDir>

    <EnvVarCommand Condition="'$(WindowsShell)' == 'true'">set</EnvVarCommand>
    <EnvVarCommand Condition="'$(WindowsShell)' != 'true'">export</EnvVarCommand>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Scenario)' == 'BuildWasmApps'">
    <WorkItemPrefix Condition="'$(TestUsingWorkloads)' == 'true'">WBT-Workloads-</WorkItemPrefix>
    <WorkItemPrefix Condition="'$(TestUsingWorkloads)' != 'true'">WBT-NoWorkload-</WorkItemPrefix>
    <WorkItemPrefix Condition="'$(WasmEnableWebcil)' == 'false'">WBT-NoWebcil-</WorkItemPrefix>
    <WorkItemPrefix Condition="'$(WasmFingerprintAssets)' == 'false'">WBT-NoFingerprint-</WorkItemPrefix>
    <WorkItemPrefix Condition="'$(WasmBundlerFriendlyBootConfig)' == 'true'">WBT-JavascriptBundler-</WorkItemPrefix>
    <WorkItemPrefix Condition="'$(RuntimeFlavor)' == 'Mono'">$(WorkItemPrefix)MONO-</WorkItemPrefix>
    <WorkItemPrefix Condition="'$(RuntimeFlavor)' == 'CoreCLR'">$(WorkItemPrefix)CLR-</WorkItemPrefix>
  </PropertyGroup>

  <ItemGroup Condition="'$(Scenario)' == 'BuildWasmApps'">
    <HelixPreCommand Condition="'$(WindowsShell)' == 'true'" Include="$(EnvVarCommand) &quot;BUILT_NUGETS_PATH=%HELIX_CORRELATION_PAYLOAD%/built-nugets&quot;" />
    <HelixPreCommand Condition="'$(WindowsShell)' != 'true'" Include="$(EnvVarCommand) &quot;BUILT_NUGETS_PATH=$HELIX_CORRELATION_PAYLOAD/built-nugets&quot;" />

    <HelixPreCommand Include="$(EnvVarCommand) &quot;XUnitTraitArg=$(_XUnitTraitArg)&quot;" />
    <HelixPreCommand Include="$(EnvVarCommand) &quot;SDK_DIR_NAME=$(SdkForWorkloadTestingDirName)&quot;" />
    <HelixPreCommand Include="$(EnvVarCommand) &quot;DOTNET_NOLOGO=1&quot;" />
    <HelixPreCommand Include="$(EnvVarCommand) &quot;DOTNET_SKIP_WORKLOAD_INTEGRITY_CHECK=1&quot;" />
  </ItemGroup>

  <Target Name="_AddWorkItemsForBuildWasmApps" Condition="'$(Scenario)' == 'BuildWasmApps'">
    <ItemGroup>
      <!-- for buildwasmapps, the archive path is set in src/libraries/Directory.Build.props, so use that -->
      <_WasmWorkItem Include="$(WorkItemArchiveWildCard)" Exclude="$(HelixCorrelationPayload)" />
    </ItemGroup>
    <PropertyGroup>
      <_BuildWasmAppsPayloadArchive>@(_WasmWorkItem)</_BuildWasmAppsPayloadArchive>
      <!-- Lanes that run with the workload installed and with the default fingerprinting/bundler
           settings fan out per test class (this includes the webcil permutations); every other
           lane runs as a single work item. Identical for every runtime flavor - only
           $(BuildWasmAppsJobsList) differs. -->
      <_FanOutPerTestClass>false</_FanOutPerTestClass>
      <_FanOutPerTestClass Condition="'$(TestUsingWorkloads)' == 'true' and '$(WasmFingerprintAssets)' == 'true' and '$(WasmBundlerFriendlyBootConfig)' == 'false'">true</_FanOutPerTestClass>
    </PropertyGroup>

    <!-- The fan-out lane has no catch-all work item, so a missing list means the tests silently do not run. -->
    <Error Condition="'$(_FanOutPerTestClass)' == 'true' and !Exists('$(BuildWasmAppsJobsList)')"
           Text="Test class list '$(BuildWasmAppsJobsList)' was not found, so no tests would be run. It is generated while building Wasm.Build.Tests." />

    <ReadLinesFromFile File="$(BuildWasmAppsJobsList)" Condition="Exists('$(BuildWasmAppsJobsList)')">
      <Output TaskParameter="Lines" ItemName="BuildWasmApps_PerJobList" />
    </ReadLinesFromFile>

    <ItemGroup>
      <HelixWorkItem Include="@(BuildWasmApps_PerJobList->'$(WorkItemPrefix)%(Identity)')" Condition="'$(_FanOutPerTestClass)' == 'true'">
        <PayloadArchive>$(_BuildWasmAppsPayloadArchive)</PayloadArchive>
        <PreCommands>$(EnvVarCommand) &quot;HELIX_XUNIT_ARGS=-class %(Identity)&quot;</PreCommands>
        <Command>$(HelixCommand)</Command>
        <Timeout>$(_workItemTimeout)</Timeout>
      </HelixWorkItem>

      <HelixWorkItem Include="$(WorkItemPrefix)Wasm.Build.Tests" Condition="'$(_FanOutPerTestClass)' != 'true'">
        <PayloadArchive>$(_BuildWasmAppsPayloadArchive)</PayloadArchive>
        <Command>$(HelixCommand)</Command>
        <Timeout>$(_workItemTimeout)</Timeout>
      </HelixWorkItem>
    </ItemGroup>
  </Target>
</Project>
