# tar archive format
magic_ustar="ustar\x00""00"
magic_gnu="ustar  \x00"
gnu_longname="././@LongLink"
pax_header="PaxHeader"
type_regular="0"
type_hardlink="1"
type_symlink="2"
type_char="3"
type_block="4"
type_directory="5"
type_fifo="6"
type_contiguous="7"
type_gnu_longlink="K"
type_gnu_longname="L"
type_gnu_sparse="S"
type_pax_extended="x"
type_pax_global="g"
pax_path="path="
pax_linkpath="linkpath="
pax_size="size="
pax_mtime="mtime="
pax_atime="atime="
pax_ctime="ctime="
pax_uid="uid="
pax_gid="gid="
pax_uname="uname="
pax_gname="gname="
pax_charset="charset="
pax_comment="comment="
gnu_sparse_map="GNU.sparse.map="
gnu_sparse_name="GNU.sparse.name="
gnu_sparse_size="GNU.sparse.size="
gnu_sparse_major="GNU.sparse.major="
octal_zero="00000000000\x00"
octal_max="77777777777\x00"
base256_pos="\x80"
base256_neg="\xff"
mode_644="0000644\x00"
mode_755="0000755\x00"
